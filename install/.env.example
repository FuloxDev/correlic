# Correlic — docker compose configuration
# Copy to .env next to docker-compose.yml and fill in the two required
# secrets. Generate each with: openssl rand -hex 32

# PostgreSQL password (only reachable inside the compose network)
DB_PASSWORD=

# Encrypts stored LLM provider keys (BYOK). Changing it later makes existing
# provider settings unreadable.
LLM_ENCRYPTION_KEY=

# Optional. Organization id for API-key auth. "default" resolves to the first org.
DEFAULT_ORG_ID=default

# ── Optional: Neo4j graph (profile "graph") ──────────────────────────────
# Leave these commented out to run on PostgreSQL alone (the default). To add
# the graph — the ai.data_exfiltration and ai.excessive_writes rules plus the
# Neo4j process-tree / attack-path timeline — uncomment all three, set a
# password of at least 8 characters, and start with:
#   docker compose --profile graph up -d
# (every later `docker compose` call needs --profile graph too, or export
# COMPOSE_PROFILES=graph).
#NEO4J_URI=bolt://neo4j:7687
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=
