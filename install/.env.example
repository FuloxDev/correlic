# Correlic — docker compose configuration
# Copy to .env next to docker-compose.yml and fill in the three secrets.
# Generate each with: openssl rand -hex 32

# PostgreSQL password (only reachable inside the compose network)
DB_PASSWORD=

# Neo4j password (only reachable inside the compose network)
NEO4J_PASSWORD=

# Encrypts stored LLM provider keys (BYOK). Changing it later makes existing
# provider settings unreadable.
LLM_ENCRYPTION_KEY=

# Optional. Leave empty and the bootstrap service generates a local API key
# on first start and prints it in its logs: docker compose logs bootstrap
# Set it to reuse a key you already created with `correlic-admin create-api-key`.
API_KEY=

# Optional. Organization id for API-key auth. "default" resolves to the first org.
DEFAULT_ORG_ID=default
