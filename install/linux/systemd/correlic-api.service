[Unit]
Description=Correlic Backend API
After=network.target postgresql.service neo4j.service
Wants=postgresql.service neo4j.service

[Service]
Type=simple
EnvironmentFile=-/etc/correlic/correlic.env
ExecStart=/usr/bin/correlic-api
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=correlic-api

[Install]
WantedBy=multi-user.target
