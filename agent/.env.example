# Correlic Agent – environment variables
# Copy to .env and adjust as needed. Main config is via YAML (see CORRELIC_CONFIG).

# Path to agent config file (YAML). Default: ~/.correlic/agent.yaml
# CORRELIC_CONFIG=/etc/correlic/agent.yaml

# --- Dispatch & volume control (Phase 12A) ---
# Event dispatch buffer size. Used when creating the dispatcher with buffer from env.
# AGENT_DISPATCH_BUFFER=4096
# Alternative name: DISPATCH_BUFFER_SIZE

# process_exec rate limit (events/sec). 0 = unlimited. Default: 200
# AGENT_EXEC_RATE_LIMIT=200

# net_accept rate limit (events/sec). 0 = unlimited. Default: 100
# AGENT_NET_ACCEPT_RATE_LIMIT=100

# Dedupe window for process_exec (ppid+exe_path) in ms. 0 = disabled. Default: 500
# AGENT_EXEC_DEDUPE_WINDOW_MS=500
