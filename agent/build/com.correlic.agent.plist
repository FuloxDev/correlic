<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- launchd job for the Correlic agent. Install to
         /Library/LaunchDaemons/com.correlic.agent.plist (root:wheel, 0644) and
         load with: sudo launchctl bootstrap system /Library/LaunchDaemons/com.correlic.agent.plist -->
    <key>Label</key>
    <string>com.correlic.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Correlic Agent.app/Contents/MacOS/correlic-agent</string>
        <string>--config</string>
        <string>/etc/correlic/agent.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/correlic/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/correlic/agent.log</string>
</dict>
</plist>
