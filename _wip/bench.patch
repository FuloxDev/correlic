+func agentMarkdown(s *Summary) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# Agent overhead — %s\n\n", s.GeneratedAt.Format("2006-01-02"))
+	fmt.Fprintf(&b, "%s\n\n", envLine(s.Environment))
+	fmt.Fprintf(&b, "Median of %v repetitions per cell (min–max in parentheses); %v s per run. "+
+		"CPU percentages are percent of **one core** (`ncpu` = %v), except *system busy*, which is percent of all cores. "+
+		"Rates are events per second split %.0f/%.0f between the fake AI tree and the noise tree.\n\n",
+		s.Config["reps"], s.Config["duration_s"], s.Environment["ncpu"], aiShare(s)*100, (1-aiShare(s))*100)
+
+	b.WriteString("## Agent process\n\n")
+	b.WriteString("| Scenario | Target exec/file/connect/dns per s | Agent CPU % | peak 1 s % | user / sys % | RSS peak MB | VmHWM MB | eBPF kernel time % | eBPF runs/s |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|\n")
+	for _, sc := range s.Scenarios {
+		w := sc.WithAgent
+		if w == nil {
+			continue
+		}
+		fmt.Fprintf(&b, "| %s | %s | %s | %s | %s / %s | %s | %s | %s | %s |\n", sc.Name, ratesStr(sc.Rates),
+			fmtStat(w.AgentCPUPct, 2), fmtStat(w.AgentCPUPeak1sPct, 1), fmtStat(w.AgentUserPct, 2), fmtStat(w.AgentSysPct, 2),
+			fmtStat(w.AgentRSSPeakMB, 1), fmtStat(w.AgentVmHWMMB, 1), fmtStat(w.BPFCPUPct, 3), fmtStat(w.BPFRunsPerS, 0))
+	}
+
+	b.WriteString("\n## Whole machine, with vs. without the agent\n\n")
+	b.WriteString("| Scenario | Workload completion % with agent | without agent | Δ completion (pp) | Achieved ops/s with | without | System busy % with | without | Δ busy (pp) | Δ busy cores | Backend planes CPU % (with) | PostgreSQL CPU % (with) |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|---|---|---|\n")
+	for _, sc := range s.Scenarios {
+		w, wo, d := sc.WithAgent, sc.WithoutAgent, sc.Delta
+		if w == nil || wo == nil || d == nil {
+			continue
+		}
+		fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n", sc.Name,
+			fmtStat(w.WorkloadCompletionPct, 1), fmtStat(wo.WorkloadCompletionPct, 1), fmtStat(d.WorkloadCompletionPct, 1),
+			fmtStat(w.WorkloadAchievedPerS, 0), fmtStat(wo.WorkloadAchievedPerS, 0),
+			fmtStat(w.SystemBusyPct, 1), fmtStat(wo.SystemBusyPct, 1), fmtStat(d.SystemBusyPct, 1), fmtStat(d.SystemBusyCores, 2),
+			fmtStat(w.BackendCPUPct, 1), fmtStat(w.PostgresCPUPct, 1))
+	}
+
+	b.WriteString("\n## Pipeline: drops and events that reached the backend (with agent)\n\n")
+	b.WriteString("| Scenario | Fake-tree ops generated | Events stored, all sessions | Stored from the fake tree, by type (% of the operations that cause the type) | Dispatcher drops: rate-limited | buffer-full | deduplicated | exec-cleanup | Agent WARN/ERROR lines |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|\n")
+	for _, sc := range s.Scenarios {
+		w := sc.WithAgent
+		if w == nil {
+			continue
+		}
+		var types []string
+		for t := range w.TreeEventsByType {
+			types = append(types, t)
+		}
+		sort.Strings(types)
+		var parts []string
+		for _, t := range types {
+			p := fmt.Sprintf("%s %s", t, fmtStat(w.TreeEventsByType[t], 0))
+			if c, ok := w.CaptureByTypePct[t]; ok {
+				p += fmt.Sprintf(" (%s%%)", fmtStat(Stat{Median: c.Median, Min: c.Min, Max: c.Max, N: 1}, 1))
+			}
+			parts = append(parts, p)
+		}
+		fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s | %s | %s | %s |\n", sc.Name,
+			fmtStat(w.AIOpsGenerated, 0), fmtStat(w.EventsStored, 0), strings.Join(parts, ", "),
+			fmtStat(w.DropsRateLimited, 0), fmtStat(w.DropsBufferFull, 0), fmtStat(w.DropsDeduplicated, 0), fmtStat(w.DropsExecCleanup, 0),
+			fmtStat(w.AgentWarnLines, 0))
+	}
+
+	b.WriteString("\n## Per-generator completion (with agent / without agent)\n\n")
+	b.WriteString("| Scenario | Kind | Target /s | Achieved /s with | without | Completion % with | without | Missed ticks with | without |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|\n")
+	for _, sc := range s.Scenarios {
+		if sc.WithAgent == nil || sc.WithoutAgent == nil {
+			continue
+		}
+		for _, k := range []string{"exec", "file", "connect", "dns"} {
+			kw, okw := sc.WithAgent.Kinds[k]
+			ko, oko := sc.WithoutAgent.Kinds[k]
+			if !okw || !oko {
+				continue
+			}
+			fmt.Fprintf(&b, "| %s | %s | %.0f | %s | %s | %s | %s | %s | %s |\n", sc.Name, k, kw.TargetPerS,
+				fmtStat(kw.AchievedPerS, 1), fmtStat(ko.AchievedPerS, 1), fmtStat(kw.CompletionPct, 1), fmtStat(ko.CompletionPct, 1),
+				fmtStat(kw.Missed, 0), fmtStat(ko.Missed, 0))
+		}
+	}
+
+	b.WriteString("\n## eBPF programs (with agent; kernel time per program, median over repetitions)\n\n")
+	b.WriteString("| Scenario | Program | Type | Runs | Run time ms | ns / run |\n|---|---|---|---|---|---|\n")
+	for _, sc := range s.Scenarios {
+		if sc.WithAgent == nil {
+			continue
+		}
+		for _, p := range sc.WithAgent.BPFPrograms {
+			fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s |\n", sc.Name, p.Name, p.Type, fmtStat(p.RunCount, 0),
+				fmtStat(Stat{Median: p.RunTimeNs.Median / 1e6, Min: p.RunTimeNs.Min / 1e6, Max: p.RunTimeNs.Max / 1e6, N: p.RunTimeNs.N}, 1),
+				fmtStat(p.AvgNs, 0))
+		}
+	}
+	if len(s.Notes) > 0 {
+		b.WriteString("\n## Notes\n\n")
+		for _, n := range s.Notes {
+			fmt.Fprintf(&b, "- %s\n", n)
+		}
+	}
+	return b.String()
+}
+
+func aiShare(s *Summary) float64 {
+	if len(s.Scenarios) > 0 {
+		return s.Scenarios[0].AIShare
+	}
+	return 0
+}
+
+func ratesStr(r map[string]float64) string {
+	return fmt.Sprintf("%.0f / %.0f / %.0f / %.0f", r["exec"], r["file"], r["connect"], r["dns"])
+}
+
+func envLine(env map[string]any) string {
+	get := func(k string) any {
+		if v, ok := env[k]; ok {
+			return v
+		}
+		return "?"
+	}
+	return fmt.Sprintf("Environment: %v, kernel %v, %v × %v, %v MB RAM, %v, commit `%v`%s.",
+		get("cpu_model"), get("kernel"), get("ncpu"), get("arch"), kbToMB(env["mem_total_kb"]), get("go_version"), get("commit"),
+		func() string {
+			if c, ok := env["container"].(bool); ok && c {
+				return " — **cloud container, not bare metal**"
+			}
+			return ""
+		}())
+}
+
+func kbToMB(v any) string {
+	if f, ok := v.(float64); ok {
+		return fmt.Sprintf("%.0f", f/1024)
+	}
+	return "?"
+}
