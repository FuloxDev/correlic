diff --git a/scripts/bench/loadgen/ingest.go b/scripts/bench/loadgen/ingest.go
new file mode 100644
index 0000000..f591de8
--- /dev/null
+++ b/scripts/bench/loadgen/ingest.go
@@ -0,0 +1,370 @@
+package main
+
+import (
+	"bytes"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"math"
+	"math/rand/v2"
+	"net/http"
+	"os"
+	"sort"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// The synthetic events mirror what the Linux agent's runners emit (see
+// agent/internal/ebpf/*_runner.go and internal/exechandler): the same field
+// names, an AI context block (ai_session_id / is_ai / ai_type) on the AI
+// share of events, and realistic paths and command lines.
+type evActor struct {
+	PID       int      `json:"pid"`
+	PPID      int      `json:"ppid"`
+	User      string   `json:"user,omitempty"`
+	ExePath   string   `json:"exe_path,omitempty"`
+	Comm      string   `json:"comm,omitempty"`
+	Cmdline   []string `json:"cmdline,omitempty"`
+	SessionID string   `json:"session_id,omitempty"`
+	Role      string   `json:"role,omitempty"`
+}
+
+type evTarget struct {
+	FilePath string `json:"file_path,omitempty"`
+	FileSize int64  `json:"file_size,omitempty"`
+	IP       string `json:"ip,omitempty"`
+	Port     int    `json:"port,omitempty"`
+	Protocol string `json:"protocol,omitempty"`
+}
+
+type canonicalEvent struct {
+	SchemaVersion int            `json:"schema_version"`
+	ID            string         `json:"id"`
+	HostID        string         `json:"host_id"`
+	Timestamp     time.Time      `json:"timestamp"`
+	Source        string         `json:"source"`
+	Type          string         `json:"type"`
+	Actor         *evActor       `json:"actor,omitempty"`
+	Target        *evTarget      `json:"target,omitempty"`
+	Context       map[string]any `json:"context,omitempty"`
+}
+
+// IngestResult is written by `loadgen ingest --out`.
+type IngestResult struct {
+	URL             string           `json:"url"`
+	Concurrency     int              `json:"concurrency"`
+	BatchSize       int              `json:"batch_size"`
+	DurationS       float64          `json:"duration_s"`
+	WarmupS         float64          `json:"warmup_s"`
+	AIShare         float64          `json:"ai_share"`
+	SuspiciousShare float64          `json:"suspicious_share"`
+	Requests        int64            `json:"requests"`
+	Requests2xx     int64            `json:"requests_2xx"`
+	RequestErrors   int64            `json:"request_errors"` // transport errors + non-2xx
+	StatusCounts    map[string]int64 `json:"status_counts"`
+	EventsSent      int64            `json:"events_sent"`
+	Accepted        int64            `json:"accepted"`
+	Rejected        int64            `json:"rejected"`
+	Sampled         int64            `json:"sampled"` // dropped by the backend sampler
+	BytesSent       int64            `json:"bytes_sent"`
+	AcceptedPerS    float64          `json:"accepted_per_s"`
+	SentPerS        float64          `json:"sent_per_s"`
+	RequestsPerS    float64          `json:"requests_per_s"`
+	AvgBatchBytes   int64            `json:"avg_batch_bytes"`
+	Latency         Latency          `json:"latency_ms"`
+	ErrorSamples    []string         `json:"error_samples,omitempty"`
+}
+
+// Latency holds request latency percentiles in milliseconds (time to the full response).
+type Latency struct {
+	P50  float64 `json:"p50"`
+	P95  float64 `json:"p95"`
+	P99  float64 `json:"p99"`
+	Max  float64 `json:"max"`
+	Mean float64 `json:"mean"`
+	N    int     `json:"n"`
+}
+
+func percentile(sorted []float64, q float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	i := int(math.Ceil(q*float64(len(sorted)))) - 1
+	if i < 0 {
+		i = 0
+	}
+	if i >= len(sorted) {
+		i = len(sorted) - 1
+	}
+	return sorted[i]
+}
+
+func summariseLatency(ms []float64) Latency {
+	if len(ms) == 0 {
+		return Latency{}
+	}
+	sort.Float64s(ms)
+	var sum float64
+	for _, v := range ms {
+		sum += v
+	}
+	return Latency{P50: percentile(ms, 0.50), P95: percentile(ms, 0.95), P99: percentile(ms, 0.99),
+		Max: ms[len(ms)-1], Mean: sum / float64(len(ms)), N: len(ms)}
+}
+
+type eventFactory struct {
+	hostID     string
+	runTag     string
+	worker     int
+	seq        int64
+	rng        *rand.Rand
+	aiShare    float64
+	suspShare  float64
+	aiSession  string
+	sourceDirs []string
+}
+
+var benignCommands = [][]string{
+	{"git", "status", "--porcelain"},
+	{"go", "build", "./..."},
+	{"npm", "test"},
+	{"python3", "-m", "pytest", "tests/"},
+	{"rg", "-n", "TODO", "src"},
+	{"node", "scripts/lint.js"},
+	{"cargo", "check"},
+	{"make", "-j4"},
+}
+
+func (f *eventFactory) next() canonicalEvent {
+	f.seq++
+	pid := 1000 + f.rng.IntN(60000)
+	ppid := 1000 + f.rng.IntN(60000)
+	ev := canonicalEvent{
+		SchemaVersion: 1,
+		ID:            "bench-" + f.runTag + "-" + strconv.Itoa(f.worker) + "-" + strconv.FormatInt(f.seq, 10),
+		HostID:        f.hostID,
+		Timestamp:     time.Now(),
+		Context:       map[string]any{},
+	}
+	if f.rng.Float64() < f.aiShare {
+		ev.Context["ai_session_id"] = f.aiSession
+		ev.Context["is_ai"] = true
+		ev.Context["ai_type"] = "claude"
+	}
+	suspicious := f.rng.Float64() < f.suspShare
+	switch r := f.rng.Float64(); {
+	case r < 0.30: // process_exec
+		ev.Type, ev.Source = "process_exec", "kernel"
+		cmd := benignCommands[f.rng.IntN(len(benignCommands))]
+		ev.Actor = &evActor{PID: pid, PPID: ppid, User: "dev", Comm: cmd[0], ExePath: "/usr/bin/" + cmd[0],
+			Cmdline: cmd, SessionID: strconv.Itoa(ppid), Role: "tool"}
+		ev.Context["exec_class"] = "build"
+		ev.Context["exec_role"] = "tool"
+	case r < 0.80: // file_open
+		ev.Type, ev.Source = "file_open", "ebpf"
+		ev.Actor = &evActor{PID: pid, PPID: ppid, Comm: "node", SessionID: strconv.Itoa(ppid)}
+		path := fmt.Sprintf("%s/pkg%d/file_%d.go", f.sourceDirs[f.rng.IntN(len(f.sourceDirs))], f.rng.IntN(40), f.rng.IntN(500))
+		if suspicious {
+			path = "/home/dev/.ssh/id_rsa"
+		}
+		ev.Target = &evTarget{FilePath: path, FileSize: int64(200 + f.rng.IntN(20000))}
+		ev.Context["category"] = "source"
+		ev.Context["open_flags"] = 0
+	default: // net_connect
+		ev.Type, ev.Source = "net_connect", "ebpf"
+		ev.Actor = &evActor{PID: pid, PPID: ppid, Comm: "node", SessionID: strconv.Itoa(ppid)}
+		ip, port := fmt.Sprintf("10.0.%d.%d", f.rng.IntN(255), 1+f.rng.IntN(254)), 443
+		if suspicious {
+			ip, port = "203.0.113.5", 4444
+		}
+		ev.Target = &evTarget{IP: ip, Port: port, Protocol: "ipv4"}
+		ev.Context["category"] = "network"
+	}
+	return ev
+}
+
+type ingestResponse struct {
+	Accepted int `json:"accepted"`
+	Rejected int `json:"rejected"`
+	Sampled  int `json:"sampled"`
+}
+
+// runIngest posts batches of synthetic canonical events from N concurrent
+// workers for a fixed duration and reports accepted events/s, request latency
+// percentiles and the backend's accepted/rejected/sampled counters.
+func runIngest(args []string) error {
+	fs := flag.NewFlagSet("ingest", flag.ContinueOnError)
+	url := fs.String("url", "https://127.0.0.1:8081", "telemetry plane base URL")
+	apiKey := fs.String("api-key", "", "agent API key (Authorization header, as the agent sends it)")
+	caFile := fs.String("ca", "", "CA certificate (PEM)")
+	certFile := fs.String("cert", "", "mTLS client certificate (PEM)")
+	keyFile := fs.String("key", "", "mTLS client key (PEM)")
+	hostID := fs.String("host-id", "bench-host", "host_id on every event (the mTLS cert is bound to the first one seen)")
+	concurrency := fs.Int("concurrency", 8, "concurrent senders")
+	batch := fs.Int("batch", 100, "events per request (backend max 500)")
+	duration := fs.Duration("duration", 30*time.Second, "measured window")
+	warmup := fs.Duration("warmup", 2*time.Second, "requests before the window are sent but not counted")
+	aiShare := fs.Float64("ai-share", 1.0, "share of events carrying an AI context (the Linux agent sends only such events)")
+	suspShare := fs.Float64("suspicious-share", 0.01, "share of file_open/net_connect events with a credential path / external C2-like target")
+	out := fs.String("out", "", "result JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if *batch < 1 || *batch > 500 {
+		return errors.New("-batch must be 1..500")
+	}
+
+	tlsCfg := &tls.Config{MinVersion: tls.VersionTLS12}
+	if *caFile != "" {
+		pem, err := os.ReadFile(*caFile)
+		if err != nil {
+			return err
+		}
+		pool := x509.NewCertPool()
+		if !pool.AppendCertsFromPEM(pem) {
+			return errors.New("no certificates in -ca")
+		}
+		tlsCfg.RootCAs = pool
+	}
+	if *certFile != "" {
+		c, err := tls.LoadX509KeyPair(*certFile, *keyFile)
+		if err != nil {
+			return fmt.Errorf("client cert: %w", err)
+		}
+		tlsCfg.Certificates = []tls.Certificate{c}
+	}
+	client := &http.Client{Timeout: 60 * time.Second, Transport: &http.Transport{
+		TLSClientConfig:     tlsCfg,
+		MaxIdleConns:        *concurrency * 2,
+		MaxIdleConnsPerHost: *concurrency * 2,
+		ForceAttemptHTTP2:   true,
+	}}
+
+	runTag := strconv.FormatInt(time.Now().UnixNano(), 36)
+	res := IngestResult{URL: *url, Concurrency: *concurrency, BatchSize: *batch, WarmupS: warmup.Seconds(),
+		AIShare: *aiShare, SuspiciousShare: *suspShare, StatusCounts: map[string]int64{}}
+
+	var (
+		mu                                                                             sync.Mutex
+		latencies                                                                      []float64
+		errSamples                                                                     []string
+		requests, ok2xx, reqErrors, eventsSent, accepted, rejected, sampled, bytesSent atomic.Int64
+		statusMu                                                                       sync.Mutex
+	)
+	measuring := atomic.Bool{}
+	stop := atomic.Bool{}
+	var wg sync.WaitGroup
+	for w := 0; w < *concurrency; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			f := &eventFactory{hostID: *hostID, runTag: runTag, worker: w, rng: rand.New(rand.NewPCG(uint64(w)+1, uint64(time.Now().UnixNano()))),
+				aiShare: *aiShare, suspShare: *suspShare, aiSession: fmt.Sprintf("bench-session-%s-%d", runTag, w),
+				sourceDirs: []string{"/home/dev/project/src", "/home/dev/project/internal", "/home/dev/project/node_modules/@types"}}
+			events := make([]canonicalEvent, *batch)
+			for !stop.Load() {
+				for i := range events {
+					events[i] = f.next()
+				}
+				body, err := json.Marshal(events)
+				if err != nil {
+					continue
+				}
+				req, err := http.NewRequest(http.MethodPost, *url+"/ingest/events", bytes.NewReader(body))
+				if err != nil {
+					continue
+				}
+				req.Header.Set("Content-Type", "application/json")
+				if *apiKey != "" {
+					req.Header.Set("Authorization", *apiKey)
+				}
+				t0 := time.Now()
+				resp, err := client.Do(req)
+				var status string
+				var ir ingestResponse
+				if err == nil {
+					rb, rerr := io.ReadAll(resp.Body)
+					resp.Body.Close()
+					status = strconv.Itoa(resp.StatusCode)
+					if rerr != nil {
+						err = rerr
+					} else if resp.StatusCode/100 == 2 {
+						_ = json.Unmarshal(rb, &ir)
+					} else {
+						err = fmt.Errorf("HTTP %d: %s", resp.StatusCode, truncate(string(rb), 120))
+					}
+				} else {
+					status = "error"
+				}
+				lat := time.Since(t0)
+				if !measuring.Load() {
+					continue
+				}
+				requests.Add(1)
+				eventsSent.Add(int64(len(events)))
+				bytesSent.Add(int64(len(body)))
+				statusMu.Lock()
+				res.StatusCounts[status]++
+				statusMu.Unlock()
+				if err != nil {
+					reqErrors.Add(1)
+					mu.Lock()
+					if len(errSamples) < 5 {
+						errSamples = append(errSamples, err.Error())
+					}
+					mu.Unlock()
+					continue
+				}
+				ok2xx.Add(1)
+				accepted.Add(int64(ir.Accepted))
+				rejected.Add(int64(ir.Rejected))
+				sampled.Add(int64(ir.Sampled))
+				mu.Lock()
+				latencies = append(latencies, float64(lat.Microseconds())/1000)
+				mu.Unlock()
+			}
+		}(w)
+	}
+	time.Sleep(*warmup)
+	start := time.Now()
+	measuring.Store(true)
+	time.Sleep(*duration)
+	measuring.Store(false)
+	wall := time.Since(start).Seconds()
+	stop.Store(true)
+	wg.Wait()
+
+	res.DurationS = wall
+	res.Requests = requests.Load()
+	res.Requests2xx = ok2xx.Load()
+	res.RequestErrors = reqErrors.Load()
+	res.EventsSent = eventsSent.Load()
+	res.Accepted = accepted.Load()
+	res.Rejected = rejected.Load()
+	res.Sampled = sampled.Load()
+	res.BytesSent = bytesSent.Load()
+	if res.Requests > 0 {
+		res.AvgBatchBytes = res.BytesSent / res.Requests
+	}
+	if wall > 0 {
+		res.AcceptedPerS = float64(res.Accepted) / wall
+		res.SentPerS = float64(res.EventsSent) / wall
+		res.RequestsPerS = float64(res.Requests) / wall
+	}
+	res.Latency = summariseLatency(latencies)
+	res.ErrorSamples = errSamples
+	return writeJSONFile(*out, res)
+}
+
+func truncate(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	return s[:n] + "..."
+}
diff --git a/scripts/bench/loadgen/listen.go b/scripts/bench/loadgen/listen.go
new file mode 100644
index 0000000..be4d383
--- /dev/null
+++ b/scripts/bench/loadgen/listen.go
@@ -0,0 +1,67 @@
+package main
+
+import (
+	"flag"
+	"fmt"
+	"net"
+	"os"
+	"os/signal"
+	"syscall"
+)
+
+// runListen serves the two local sinks the workload needs: a TCP listener that
+// accepts and immediately closes connections, and a UDP socket (default port
+// 53, so the agent's DNS kprobe sees the sends) that discards datagrams.
+func runListen(args []string) error {
+	fs := flag.NewFlagSet("listen", flag.ContinueOnError)
+	tcpAddr := fs.String("tcp", "127.0.0.1:0", "TCP listen address (port 0 = pick a free port)")
+	udpAddr := fs.String("udp", "127.0.0.1:53", "UDP listen address")
+	readyFile := fs.String("ready-file", "", "write 'tcp=<port> udp=<port>' here once both sockets listen")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	ln, err := net.Listen("tcp", *tcpAddr)
+	if err != nil {
+		return fmt.Errorf("tcp listen: %w", err)
+	}
+	defer ln.Close()
+	pc, err := net.ListenPacket("udp", *udpAddr)
+	if err != nil {
+		return fmt.Errorf("udp listen: %w", err)
+	}
+	defer pc.Close()
+
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			c.Close()
+		}
+	}()
+	go func() {
+		buf := make([]byte, 4096)
+		for {
+			if _, _, err := pc.ReadFrom(buf); err != nil {
+				return
+			}
+		}
+	}()
+
+	tcpPort := ln.Addr().(*net.TCPAddr).Port
+	udpPort := pc.LocalAddr().(*net.UDPAddr).Port
+	line := fmt.Sprintf("tcp=%d udp=%d\n", tcpPort, udpPort)
+	if *readyFile != "" {
+		if err := os.WriteFile(*readyFile, []byte(line), 0o644); err != nil {
+			return err
+		}
+	}
+	fmt.Print(line)
+
+	sig := make(chan os.Signal, 1)
+	signal.Notify(sig, syscall.SIGINT, syscall.SIGTERM)
+	<-sig
+	return nil
+}
diff --git a/scripts/bench/loadgen/loadgen_test.go b/scripts/bench/loadgen/loadgen_test.go
new file mode 100644
index 0000000..5a899a7
--- /dev/null
+++ b/scripts/bench/loadgen/loadgen_test.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSummariseAgentLog(t *testing.T) {
+	log := strings.Join([]string{
+		`time=1 level=INFO msg="agent drop stats" rate_limited="map[process_exec:120 net_connect:3]" buffer_full=map[] deduplicated=48 exec_cleanup=map[exec_helper_burst:22]`,
+		`time=2 level=INFO msg="agent drop stats" rate_limited=map[process_exec:80] buffer_full="map[file_open:5]" deduplicated=2 exec_cleanup=map[]`,
+		`time=3 level=INFO msg="agent drop" reason=rate_limited event_type=process_exec`,
+		`time=4 level=INFO msg="AI session created" component=lineage_tracker pid=1 comm=claude ai_type=claude`,
+		`time=5 level=WARN msg="eBPF DNS runner init failed" error="attaching udp_sendmsg kprobe"`,
+		`time=6 level=ERROR msg="boom"`,
+		`time=7 level=INFO msg="connect events ring buffer closed, stopping"`,
+	}, "\n")
+	s, err := summariseAgentLog(strings.NewReader(log))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Lines != 7 || s.DropStatsLines != 2 {
+		t.Fatalf("lines=%d dropStats=%d", s.Lines, s.DropStatsLines)
+	}
+	if s.RateLimited["process_exec"] != 200 || s.RateLimited["net_connect"] != 3 {
+		t.Fatalf("rate_limited=%v", s.RateLimited)
+	}
+	if s.BufferFull["file_open"] != 5 || s.Deduplicated != 50 || s.ExecCleanup["exec_helper_burst"] != 22 {
+		t.Fatalf("buffer_full=%v dedup=%d cleanup=%v", s.BufferFull, s.Deduplicated, s.ExecCleanup)
+	}
+	if s.DropReasons["rate_limited"] != 1 || s.AISessions != 1 || s.Warn != 1 || s.Error != 1 || s.RingbufMentions != 1 {
+		t.Fatalf("reasons=%v sessions=%d warn=%d error=%d ringbuf=%d", s.DropReasons, s.AISessions, s.Warn, s.Error, s.RingbufMentions)
+	}
+	if len(s.WarnSamples) != 2 || s.WarnSamples[0] != "eBPF DNS runner init failed" {
+		t.Fatalf("warn samples=%v", s.WarnSamples)
+	}
+}
+
+func TestStat(t *testing.T) {
+	s := stat([]float64{3, 1, 2})
+	if s.Median != 2 || s.Min != 1 || s.Max != 3 || s.N != 3 {
+		t.Fatalf("%+v", s)
+	}
+	if e := stat([]float64{4, 1, 3, 2}); e.Median != 2.5 {
+		t.Fatalf("even median %v", e.Median)
+	}
+	if z := stat(nil); z.N != 0 || fmtStat(z, 1) != "–" {
+		t.Fatalf("empty stat %+v %q", z, fmtStat(z, 1))
+	}
+	if got := fmtStat(s, 1); got != "2.0 (1.0–3.0)" {
+		t.Fatalf("fmtStat %q", got)
+	}
+	if got := fmtStat(stat([]float64{7}), 0); got != "7" {
+		t.Fatalf("single value %q", got)
+	}
+}
+
+func TestLatencyPercentiles(t *testing.T) {
+	var ms []float64
+	for i := 1; i <= 100; i++ {
+		ms = append(ms, float64(i))
+	}
+	l := summariseLatency(ms)
+	if l.P50 != 50 || l.P95 != 95 || l.P99 != 99 || l.Max != 100 || l.Mean != 50.5 || l.N != 100 {
+		t.Fatalf("%+v", l)
+	}
+	if e := summariseLatency(nil); e.N != 0 {
+		t.Fatalf("%+v", e)
+	}
+}
+
+func TestDNSQuery(t *testing.T) {
+	q := dnsQuery(7, "bench1.example.com")
+	// header(12) + 1+6 + 1+7 + 1+3 + root(1) + qtype/qclass(4)
+	if len(q) != 12+7+8+4+1+4 {
+		t.Fatalf("len=%d", len(q))
+	}
+	if q[0] != 0 || q[1] != 7 || q[5] != 1 {
+		t.Fatalf("header %v", q[:6])
+	}
+	if q[12] != 6 || string(q[13:19]) != "bench1" || q[19] != 7 || q[len(q)-5] != 0 {
+		t.Fatalf("labels %v", q[12:])
+	}
+}
+
+func TestReadProcTicksSelf(t *testing.T) {
+	if _, _, err := readProcTicks(1); err != nil {
+		t.Skipf("no /proc: %v", err)
+	}
+	if _, _, err := readProcTicks(-1); err == nil {
+		t.Fatal("expected error for pid -1")
+	}
+}
diff --git a/scripts/bench/loadgen/main.go b/scripts/bench/loadgen/main.go
new file mode 100644
index 0000000..7170066
--- /dev/null
+++ b/scripts/bench/loadgen/main.go
@@ -0,0 +1,197 @@
+// Command loadgen is the benchmark helper for scripts/bench: it generates
+// synthetic host workloads, posts synthetic canonical events to the telemetry
+// plane, samples /proc and eBPF program statistics, parses the agent log and
+// aggregates raw run directories into the committed summary files.
+//
+// It is Linux-only and intentionally self-contained (one binary, no
+// dependency on the agent or backend modules) so `go build ./...` in those
+// modules is unaffected.
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+func usage() {
+	fmt.Fprint(os.Stderr, `usage: loadgen <command> [flags]
+
+commands:
+  sysinfo    print kernel/CPU/memory/Go facts as JSON
+  listen     run the local TCP and UDP (DNS-like) sinks the workload talks to
+  workload   generate execs, file opens, TCP connects and UDP/53 sends at fixed rates
+  monitor    sample /proc CPU+RSS of processes (and eBPF program run time) for a duration
+  bpfstats   print one snapshot of all loaded eBPF programs' run_count/run_time_ns
+  ingest     POST synthetic canonical event batches to /ingest/events and measure latency
+  agentlog   summarise dispatcher drop stats / warnings from an agent log
+  report     aggregate raw run directories into summary JSON + markdown
+
+Run "loadgen <command> -h" for the flags of a command.
+`)
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		usage()
+		os.Exit(2)
+	}
+	var err error
+	args := os.Args[2:]
+	switch os.Args[1] {
+	case "sysinfo":
+		err = runSysInfo(args)
+	case "listen":
+		err = runListen(args)
+	case "workload":
+		err = runWorkload(args)
+	case "monitor":
+		err = runMonitor(args)
+	case "bpfstats":
+		err = runBPFStats(args)
+	case "ingest":
+		err = runIngest(args)
+	case "agentlog":
+		err = runAgentLog(args)
+	case "report":
+		err = runReport(args)
+	case "-h", "--help", "help":
+		usage()
+		return
+	default:
+		usage()
+		os.Exit(2)
+	}
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "loadgen %s: %v\n", os.Args[1], err)
+		os.Exit(1)
+	}
+}
+
+// SysInfo describes the machine the benchmark ran on.
+type SysInfo struct {
+	Kernel      string `json:"kernel"`
+	Arch        string `json:"arch"`
+	CPUModel    string `json:"cpu_model"`
+	NCPU        int    `json:"ncpu"`
+	MemTotalKB  int64  `json:"mem_total_kb"`
+	GoVersion   string `json:"go_version"`
+	Container   bool   `json:"container"`
+	ContainerBy string `json:"container_hint,omitempty"`
+	BPFStats    string `json:"bpf_stats_enabled,omitempty"`
+	Hostname    string `json:"hostname,omitempty"`
+}
+
+func readSysInfo() SysInfo {
+	si := SysInfo{Arch: runtime.GOARCH, NCPU: runtime.NumCPU(), GoVersion: runtime.Version()}
+	if b, err := os.ReadFile("/proc/sys/kernel/osrelease"); err == nil {
+		si.Kernel = strings.TrimSpace(string(b))
+	}
+	if b, err := os.ReadFile("/proc/cpuinfo"); err == nil {
+		for _, l := range strings.Split(string(b), "\n") {
+			if strings.HasPrefix(l, "model name") {
+				if i := strings.Index(l, ":"); i >= 0 {
+					si.CPUModel = strings.TrimSpace(l[i+1:])
+				}
+				break
+			}
+		}
+	}
+	if b, err := os.ReadFile("/proc/meminfo"); err == nil {
+		for _, l := range strings.Split(string(b), "\n") {
+			if strings.HasPrefix(l, "MemTotal:") {
+				f := strings.Fields(l)
+				if len(f) >= 2 {
+					si.MemTotalKB, _ = strconv.ParseInt(f[1], 10, 64)
+				}
+				break
+			}
+		}
+	}
+	if b, err := os.ReadFile("/proc/sys/kernel/bpf_stats_enabled"); err == nil {
+		si.BPFStats = strings.TrimSpace(string(b))
+	}
+	si.Hostname, _ = os.Hostname()
+	if _, err := os.Stat("/.dockerenv"); err == nil {
+		si.Container, si.ContainerBy = true, "/.dockerenv"
+	} else if b, err := os.ReadFile("/proc/1/cgroup"); err == nil {
+		s := string(b)
+		for _, hint := range []string{"docker", "lxc", "containerd", "kubepods", "libpod", "machine.slice"} {
+			if strings.Contains(s, hint) {
+				si.Container, si.ContainerBy = true, "/proc/1/cgroup:"+hint
+				break
+			}
+		}
+	}
+	if !si.Container {
+		// pid 1 that is not an init system is the usual sign of a container.
+		if b, err := os.ReadFile("/proc/1/comm"); err == nil {
+			c := strings.TrimSpace(string(b))
+			if c != "systemd" && c != "init" {
+				si.Container, si.ContainerBy = true, "/proc/1/comm:"+c
+			}
+		}
+	}
+	return si
+}
+
+// runSysInfo prints the machine facts; -set key=value adds extra string fields
+// (the scripts use it for the git commit and the run date).
+func runSysInfo(args []string) error {
+	fs := flag.NewFlagSet("sysinfo", flag.ContinueOnError)
+	var extra multiFlag
+	fs.Var(&extra, "set", "extra key=value to include (repeatable)")
+	out := fs.String("out", "", "JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	b, err := json.Marshal(readSysInfo())
+	if err != nil {
+		return err
+	}
+	m := map[string]any{}
+	if err := json.Unmarshal(b, &m); err != nil {
+		return err
+	}
+	for _, kv := range extra {
+		k, v, ok := strings.Cut(kv, "=")
+		if !ok {
+			return fmt.Errorf("-set wants key=value, got %q", kv)
+		}
+		m[k] = v
+	}
+	return writeJSONFile(*out, m)
+}
+
+func writeJSONTo(w *os.File, v any) error {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	return enc.Encode(v)
+}
+
+func writeJSONFile(path string, v any) error {
+	if path == "" || path == "-" {
+		return writeJSONTo(os.Stdout, v)
+	}
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	if err := writeJSONTo(f, v); err != nil {
+		f.Close()
+		return err
+	}
+	return f.Close()
+}
+
+func readJSONFile(path string, v any) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(b, v)
+}
diff --git a/scripts/bench/loadgen/monitor.go b/scripts/bench/loadgen/monitor.go
new file mode 100644
index 0000000..67df165
--- /dev/null
+++ b/scripts/bench/loadgen/monitor.go
@@ -0,0 +1,489 @@
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/cilium/ebpf"
+)
+
+// userHZ is the unit of utime/stime in /proc/<pid>/stat. It is fixed to 100
+// for the /proc interface on every Linux architecture (USER_HZ), whatever
+// CONFIG_HZ the kernel was built with.
+const userHZ = 100
+
+// ProcSample is one per-interval observation of a process.
+type ProcSample struct {
+	T      float64 `json:"t"`       // seconds since monitor start
+	CPUPct float64 `json:"cpu_pct"` // % of one core during the interval
+	RSSKB  int64   `json:"rss_kb"`
+}
+
+// ProcStats summarises one process (or the set of processes sharing a comm).
+type ProcStats struct {
+	Name          string       `json:"name"`
+	PID           int          `json:"pid,omitempty"`
+	Comm          string       `json:"comm,omitempty"`
+	Found         bool         `json:"found"`
+	Exited        bool         `json:"exited"`
+	CPUPct        float64      `json:"cpu_pct"` // user+sys, % of one core averaged over the window
+	UserPct       float64      `json:"user_pct"`
+	SysPct        float64      `json:"sys_pct"`
+	CPUPctPeak1s  float64      `json:"cpu_pct_peak_1s"` // highest single interval
+	CPUSeconds    float64      `json:"cpu_s"`
+	RSSPeakKB     int64        `json:"rss_peak_kb"` // max sampled VmRSS (sum over pids for comm aggregates)
+	RSSAvgKB      int64        `json:"rss_avg_kb"`
+	VmHWMKB       int64        `json:"vmhwm_kb,omitempty"` // kernel high-water mark since process start
+	PIDsSeen      int          `json:"pids_seen,omitempty"`
+	Samples       []ProcSample `json:"samples,omitempty"`
+	userTicks     int64
+	sysTicks      int64
+	lastTicks     map[int]int64 // comm aggregates: pid -> last user+sys ticks
+	lastUserTicks map[int]int64
+	rssSum        int64
+	rssN          int64
+}
+
+// SystemStats is the whole-machine CPU split from /proc/stat over the window.
+type SystemStats struct {
+	BusyPct   float64 `json:"busy_pct"` // 100 - idle - iowait, % of all cores
+	UserPct   float64 `json:"user_pct"`
+	SysPct    float64 `json:"sys_pct"`
+	IdlePct   float64 `json:"idle_pct"`
+	IOWaitPct float64 `json:"iowait_pct"`
+	IRQPct    float64 `json:"irq_pct"` // irq + softirq
+	StealPct  float64 `json:"steal_pct"`
+	BusyCores float64 `json:"busy_cores"` // busy_pct * ncpu / 100
+}
+
+// BPFProg is one loaded eBPF program's cumulative kernel statistics.
+type BPFProg struct {
+	ID              uint32 `json:"id"`
+	Name            string `json:"name"`
+	Type            string `json:"type"`
+	RunCount        uint64 `json:"run_count"`
+	RunTimeNs       uint64 `json:"run_time_ns"`
+	RecursionMisses uint64 `json:"recursion_misses"`
+}
+
+// BPFStats is the delta of all programs over the window.
+type BPFStats struct {
+	StatsEnabled   bool      `json:"stats_enabled"` // /proc/sys/kernel/bpf_stats_enabled
+	OwnerPID       int       `json:"owner_pid,omitempty"`
+	OwnedPrograms  int       `json:"owned_programs,omitempty"` // programs the owner pid holds (with -bpf-pid)
+	Programs       []BPFProg `json:"programs"`                 // only programs that ran during the window
+	TotalRunCount  uint64    `json:"total_run_count"`
+	TotalRunTimeNs uint64    `json:"total_run_time_ns"`
+	CPUPct         float64   `json:"cpu_pct"` // total_run_time / wall, % of one core
+	Error          string    `json:"error,omitempty"`
+}
+
+// MonitorResult is written by `loadgen monitor --out`.
+type MonitorResult struct {
+	StartedAt time.Time             `json:"started_at"`
+	DurationS float64               `json:"duration_s"`
+	IntervalS float64               `json:"interval_s"`
+	NCPU      int                   `json:"ncpu"`
+	Procs     map[string]*ProcStats `json:"procs"`
+	Comms     map[string]*ProcStats `json:"comms,omitempty"`
+	System    SystemStats           `json:"system"`
+	BPF       *BPFStats             `json:"bpf,omitempty"`
+}
+
+type cpuTimes struct{ user, nice, sys, idle, iowait, irq, softirq, steal int64 }
+
+func (c cpuTimes) total() int64 {
+	return c.user + c.nice + c.sys + c.idle + c.iowait + c.irq + c.softirq + c.steal
+}
+
+func readCPUTimes() (cpuTimes, error) {
+	b, err := os.ReadFile("/proc/stat")
+	if err != nil {
+		return cpuTimes{}, err
+	}
+	for _, l := range strings.Split(string(b), "\n") {
+		if strings.HasPrefix(l, "cpu ") {
+			f := strings.Fields(l)
+			if len(f) < 9 {
+				return cpuTimes{}, errors.New("short cpu line in /proc/stat")
+			}
+			var v [8]int64
+			for i := range v {
+				v[i], _ = strconv.ParseInt(f[i+1], 10, 64)
+			}
+			return cpuTimes{v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]}, nil
+		}
+	}
+	return cpuTimes{}, errors.New("no cpu line in /proc/stat")
+}
+
+// readProcTicks returns utime and stime (USER_HZ ticks) of a pid, all threads included.
+func readProcTicks(pid int) (user, sys int64, err error) {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return 0, 0, err
+	}
+	s := string(b)
+	i := strings.LastIndex(s, ")")
+	if i < 0 {
+		return 0, 0, errors.New("malformed stat")
+	}
+	f := strings.Fields(s[i+1:]) // f[0] = state (field 3), utime = field 14 -> f[11], stime -> f[12]
+	if len(f) < 13 {
+		return 0, 0, errors.New("short stat")
+	}
+	user, _ = strconv.ParseInt(f[11], 10, 64)
+	sys, _ = strconv.ParseInt(f[12], 10, 64)
+	return user, sys, nil
+}
+
+func readProcMem(pid int) (rssKB, hwmKB int64) {
+	b, err := os.ReadFile(fmt.Sprintf("/proc/%d/status", pid))
+	if err != nil {
+		return 0, 0
+	}
+	for _, l := range strings.Split(string(b), "\n") {
+		if strings.HasPrefix(l, "VmRSS:") {
+			rssKB = parseKB(l)
+		} else if strings.HasPrefix(l, "VmHWM:") {
+			hwmKB = parseKB(l)
+		}
+	}
+	return rssKB, hwmKB
+}
+
+func parseKB(l string) int64 {
+	f := strings.Fields(l)
+	if len(f) < 2 {
+		return 0
+	}
+	n, _ := strconv.ParseInt(f[1], 10, 64)
+	return n
+}
+
+func pidsWithComm(comm string) []int {
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil
+	}
+	var pids []int
+	for _, e := range entries {
+		pid, err := strconv.Atoi(e.Name())
+		if err != nil {
+			continue
+		}
+		b, err := os.ReadFile(filepath.Join("/proc", e.Name(), "comm"))
+		if err != nil {
+			continue
+		}
+		if strings.TrimSpace(string(b)) == comm {
+			pids = append(pids, pid)
+		}
+	}
+	return pids
+}
+
+type multiFlag []string
+
+func (m *multiFlag) String() string     { return strings.Join(*m, ",") }
+func (m *multiFlag) Set(s string) error { *m = append(*m, s); return nil }
+
+// runMonitor samples named pids (and optionally every process with a given
+// comm) once per interval for a duration and reports averaged CPU, peak RSS,
+// whole-machine CPU split and, with -bpf, the run time and run count of every
+// eBPF program that executed during the window (bpf_stats_enabled must be 1).
+func runMonitor(args []string) error {
+	fs := flag.NewFlagSet("monitor", flag.ContinueOnError)
+	duration := fs.Duration("duration", 60*time.Second, "sampling window")
+	interval := fs.Duration("interval", time.Second, "sampling interval")
+	var procs, comms multiFlag
+	fs.Var(&procs, "proc", "name=pid to sample (repeatable)")
+	fs.Var(&comms, "comm", "aggregate every process with this comm (repeatable, e.g. postgres)")
+	withBPF := fs.Bool("bpf", false, "also snapshot eBPF program statistics before/after")
+	bpfPID := fs.Int("bpf-pid", 0, "with -bpf: only count programs this pid holds a file descriptor for (its /proc/<pid>/fdinfo), so other loaders on the host are excluded")
+	keepSamples := fs.Bool("samples", true, "keep per-interval samples in the output")
+	out := fs.String("out", "", "result JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	res := MonitorResult{StartedAt: time.Now(), IntervalS: interval.Seconds(), NCPU: readSysInfo().NCPU, Procs: map[string]*ProcStats{}}
+	for _, p := range procs {
+		name, pidS, ok := strings.Cut(p, "=")
+		if !ok {
+			return fmt.Errorf("-proc wants name=pid, got %q", p)
+		}
+		pid, err := strconv.Atoi(pidS)
+		if err != nil {
+			return fmt.Errorf("-proc %q: %w", p, err)
+		}
+		ps := &ProcStats{Name: name, PID: pid}
+		if u, s, err := readProcTicks(pid); err == nil {
+			ps.Found = true
+			ps.userTicks, ps.sysTicks = u, s
+		}
+		res.Procs[name] = ps
+	}
+	if len(comms) > 0 {
+		res.Comms = map[string]*ProcStats{}
+		for _, c := range comms {
+			ps := &ProcStats{Name: c, Comm: c, lastTicks: map[int]int64{}, lastUserTicks: map[int]int64{}}
+			for _, pid := range pidsWithComm(c) {
+				if u, s, err := readProcTicks(pid); err == nil {
+					ps.lastTicks[pid] = u + s
+					ps.lastUserTicks[pid] = u
+					ps.Found = true
+				}
+			}
+			res.Comms[c] = ps
+		}
+	}
+
+	cpu0, err := readCPUTimes()
+	if err != nil {
+		return err
+	}
+	var bpf0 []BPFProg
+	var bpfErr error
+	var owned map[uint32]bool
+	if *withBPF {
+		bpf0, bpfErr = bpfSnapshot()
+		if *bpfPID > 0 {
+			owned = progIDsOfPID(*bpfPID)
+			if len(owned) == 0 && bpfErr == nil {
+				bpfErr = fmt.Errorf("pid %d holds no BPF program fds", *bpfPID)
+			}
+		}
+	}
+
+	start := time.Now()
+	ticker := time.NewTicker(*interval)
+	defer ticker.Stop()
+	prevUser := map[string]int64{}
+	prevSys := map[string]int64{}
+	for name, ps := range res.Procs {
+		prevUser[name], prevSys[name] = ps.userTicks, ps.sysTicks
+	}
+	lastT := start
+	for now := range ticker.C {
+		dt := now.Sub(lastT).Seconds()
+		lastT = now
+		t := now.Sub(start).Seconds()
+		for name, ps := range res.Procs {
+			u, s, err := readProcTicks(ps.PID)
+			if err != nil {
+				if ps.Found {
+					ps.Exited = true
+				}
+				continue
+			}
+			ps.Found = true
+			du, ds := u-prevUser[name], s-prevSys[name]
+			prevUser[name], prevSys[name] = u, s
+			pct := float64(du+ds) / userHZ / dt * 100
+			if pct > ps.CPUPctPeak1s {
+				ps.CPUPctPeak1s = pct
+			}
+			rss, hwm := readProcMem(ps.PID)
+			if rss > ps.RSSPeakKB {
+				ps.RSSPeakKB = rss
+			}
+			if hwm > ps.VmHWMKB {
+				ps.VmHWMKB = hwm
+			}
+			ps.rssSum += rss
+			ps.rssN++
+			if *keepSamples {
+				ps.Samples = append(ps.Samples, ProcSample{T: t, CPUPct: pct, RSSKB: rss})
+			}
+		}
+		for _, ps := range res.Comms {
+			var dtAll, duAll, rssAll int64
+			for _, pid := range pidsWithComm(ps.Comm) {
+				u, s, err := readProcTicks(pid)
+				if err != nil {
+					continue
+				}
+				ps.Found = true
+				if last, ok := ps.lastTicks[pid]; ok {
+					dtAll += (u + s) - last
+					duAll += u - ps.lastUserTicks[pid]
+				}
+				ps.lastTicks[pid] = u + s
+				ps.lastUserTicks[pid] = u
+				rss, _ := readProcMem(pid)
+				rssAll += rss
+			}
+			ps.userTicks += duAll
+			ps.sysTicks += dtAll - duAll
+			pct := float64(dtAll) / userHZ / dt * 100
+			if pct > ps.CPUPctPeak1s {
+				ps.CPUPctPeak1s = pct
+			}
+			if rssAll > ps.RSSPeakKB {
+				ps.RSSPeakKB = rssAll
+			}
+			ps.rssSum += rssAll
+			ps.rssN++
+			if *keepSamples {
+				ps.Samples = append(ps.Samples, ProcSample{T: t, CPUPct: pct, RSSKB: rssAll})
+			}
+		}
+		if now.Sub(start) >= *duration {
+			break
+		}
+	}
+	wall := time.Since(start).Seconds()
+	res.DurationS = wall
+
+	for name, ps := range res.Procs {
+		du := prevUser[name] - ps.userTicks
+		ds := prevSys[name] - ps.sysTicks
+		ps.UserPct = float64(du) / userHZ / wall * 100
+		ps.SysPct = float64(ds) / userHZ / wall * 100
+		ps.CPUPct = ps.UserPct + ps.SysPct
+		ps.CPUSeconds = float64(du+ds) / userHZ
+		if ps.rssN > 0 {
+			ps.RSSAvgKB = ps.rssSum / ps.rssN
+		}
+	}
+	for _, ps := range res.Comms {
+		ps.PIDsSeen = len(ps.lastTicks)
+		ps.UserPct = float64(ps.userTicks) / userHZ / wall * 100
+		ps.SysPct = float64(ps.sysTicks) / userHZ / wall * 100
+		ps.CPUPct = ps.UserPct + ps.SysPct
+		ps.CPUSeconds = float64(ps.userTicks+ps.sysTicks) / userHZ
+		if ps.rssN > 0 {
+			ps.RSSAvgKB = ps.rssSum / ps.rssN
+		}
+	}
+
+	cpu1, err := readCPUTimes()
+	if err != nil {
+		return err
+	}
+	d := cpuTimes{cpu1.user - cpu0.user, cpu1.nice - cpu0.nice, cpu1.sys - cpu0.sys, cpu1.idle - cpu0.idle,
+		cpu1.iowait - cpu0.iowait, cpu1.irq - cpu0.irq, cpu1.softirq - cpu0.softirq, cpu1.steal - cpu0.steal}
+	if tot := float64(d.total()); tot > 0 {
+		res.System = SystemStats{
+			BusyPct:   float64(d.total()-d.idle-d.iowait) / tot * 100,
+			UserPct:   float64(d.user+d.nice) / tot * 100,
+			SysPct:    float64(d.sys) / tot * 100,
+			IdlePct:   float64(d.idle) / tot * 100,
+			IOWaitPct: float64(d.iowait) / tot * 100,
+			IRQPct:    float64(d.irq+d.softirq) / tot * 100,
+			StealPct:  float64(d.steal) / tot * 100,
+		}
+		res.System.BusyCores = res.System.BusyPct * float64(res.NCPU) / 100
+	}
+
+	if *withBPF {
+		st := &BPFStats{OwnerPID: *bpfPID, OwnedPrograms: len(owned)}
+		if b, err := os.ReadFile("/proc/sys/kernel/bpf_stats_enabled"); err == nil {
+			st.StatsEnabled = strings.TrimSpace(string(b)) != "0"
+		}
+		if bpfErr != nil {
+			st.Error = bpfErr.Error()
+		} else if bpf1, err := bpfSnapshot(); err != nil {
+			st.Error = err.Error()
+		} else {
+			before := map[uint32]BPFProg{}
+			for _, p := range bpf0 {
+				before[p.ID] = p
+			}
+			for _, p := range bpf1 {
+				if owned != nil && !owned[p.ID] {
+					continue
+				}
+				b := before[p.ID]
+				dp := BPFProg{ID: p.ID, Name: p.Name, Type: p.Type,
+					RunCount: p.RunCount - b.RunCount, RunTimeNs: p.RunTimeNs - b.RunTimeNs,
+					RecursionMisses: p.RecursionMisses - b.RecursionMisses}
+				if dp.RunCount == 0 && dp.RunTimeNs == 0 {
+					continue
+				}
+				st.Programs = append(st.Programs, dp)
+				st.TotalRunCount += dp.RunCount
+				st.TotalRunTimeNs += dp.RunTimeNs
+			}
+			sort.Slice(st.Programs, func(i, j int) bool { return st.Programs[i].RunTimeNs > st.Programs[j].RunTimeNs })
+			st.CPUPct = float64(st.TotalRunTimeNs) / 1e9 / wall * 100
+		}
+		res.BPF = st
+	}
+	return writeJSONFile(*out, res)
+}
+
+// bpfSnapshot enumerates every loaded eBPF program and returns its cumulative
+// run statistics (zero unless /proc/sys/kernel/bpf_stats_enabled is 1).
+func bpfSnapshot() ([]BPFProg, error) {
+	out := []BPFProg{}
+	var id ebpf.ProgramID
+	for {
+		next, err := ebpf.ProgramGetNextID(id)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				return out, nil
+			}
+			return out, fmt.Errorf("enumerating programs (needs root/CAP_BPF): %w", err)
+		}
+		id = next
+		p, err := ebpf.NewProgramFromID(id)
+		if err != nil {
+			continue // unloaded between calls
+		}
+		info, ierr := p.Info()
+		st, serr := p.Stats()
+		p.Close()
+		if ierr != nil || serr != nil {
+			continue
+		}
+		out = append(out, BPFProg{ID: uint32(id), Name: info.Name, Type: info.Type.String(),
+			RunCount: st.RunCount, RunTimeNs: uint64(st.Runtime), RecursionMisses: st.RecursionMisses})
+	}
+}
+
+// progIDsOfPID returns the ids of the BPF programs a process holds file
+// descriptors for (fdinfo of a program fd has a "prog_id:" line).
+func progIDsOfPID(pid int) map[uint32]bool {
+	ids := map[uint32]bool{}
+	dir := fmt.Sprintf("/proc/%d/fdinfo", pid)
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return ids
+	}
+	for _, e := range entries {
+		b, err := os.ReadFile(filepath.Join(dir, e.Name()))
+		if err != nil {
+			continue
+		}
+		for _, l := range strings.Split(string(b), "\n") {
+			if strings.HasPrefix(l, "prog_id:") {
+				if n, err := strconv.ParseUint(strings.TrimSpace(strings.TrimPrefix(l, "prog_id:")), 10, 32); err == nil {
+					ids[uint32(n)] = true
+				}
+			}
+		}
+	}
+	return ids
+}
+
+func runBPFStats(args []string) error {
+	fs := flag.NewFlagSet("bpfstats", flag.ContinueOnError)
+	out := fs.String("out", "", "JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	progs, err := bpfSnapshot()
+	if err != nil {
+		return err
+	}
+	return writeJSONFile(*out, progs)
+}
