+// ---- backend ingest -------------------------------------------------------
+
+type IngestConfigSummary struct {
+	Label               string   `json:"label"`
+	Concurrency         int      `json:"concurrency"`
+	BatchSize           int      `json:"batch_size"`
+	Sampling            string   `json:"sampling"`
+	AIShare             float64  `json:"ai_share"`
+	Runs                int      `json:"runs"`
+	AcceptedPerS        Stat     `json:"accepted_per_s"`
+	SentPerS            Stat     `json:"sent_per_s"`
+	RequestsPerS        Stat     `json:"requests_per_s"`
+	P50Ms               Stat     `json:"p50_ms"`
+	P95Ms               Stat     `json:"p95_ms"`
+	P99Ms               Stat     `json:"p99_ms"`
+	MaxMs               Stat     `json:"max_ms"`
+	RequestErrors       Stat     `json:"request_errors"`
+	Rejected            Stat     `json:"rejected"`
+	Sampled             Stat     `json:"sampled"`
+	SampledPct          Stat     `json:"sampled_pct"`
+	TelemetryCPUPct     Stat     `json:"telemetry_plane_cpu_pct"`
+	TelemetryRSSPeakMB  Stat     `json:"telemetry_plane_rss_peak_mb"`
+	APICPUPct           Stat     `json:"api_plane_cpu_pct"`
+	PostgresCPUPct      Stat     `json:"postgres_cpu_pct"`
+	SystemBusyPct       Stat     `json:"system_busy_pct"`
+	LoadgenCPUPct       Stat     `json:"loadgen_cpu_pct"`
+	DBGrowthMB          Stat     `json:"db_growth_mb"`
+	BytesPerStoredEvent Stat     `json:"bytes_per_stored_event"`
+	EventsRowsStored    Stat     `json:"events_rows_stored"`
+	TelemetryRowsStored Stat     `json:"telemetry_events_rows_stored"`
+	Findings            Stat     `json:"findings"`
+	FindingsPerMin      Stat     `json:"findings_per_min"`
+	Incidents           Stat     `json:"incidents"`
+	ErrorSamples        []string `json:"error_samples,omitempty"`
+}
+
+func summariseIngest(runs []rawRun) []IngestConfigSummary {
+	byLabel := map[string][]rawRun{}
+	var order []string
+	for _, r := range runs {
+		if _, ok := byLabel[r.meta.Label]; !ok {
+			order = append(order, r.meta.Label)
+		}
+		byLabel[r.meta.Label] = append(byLabel[r.meta.Label], r)
+	}
+	sort.Slice(order, func(i, j int) bool {
+		a, b := byLabel[order[i]][0].meta, byLabel[order[j]][0].meta
+		if a.Sampling != b.Sampling {
+			return a.Sampling < b.Sampling // "default" before "off"
+		}
+		if a.IngestAI != b.IngestAI {
+			return a.IngestAI > b.IngestAI
+		}
+		return a.Concurrency < b.Concurrency
+	})
+	var out []IngestConfigSummary
+	for _, label := range order {
+		rs := byLabel[label]
+		m := rs[0].meta
+		c := IngestConfigSummary{Label: label, Concurrency: m.Concurrency, BatchSize: m.Batch, Sampling: m.Sampling, AIShare: m.IngestAI, Runs: len(rs)}
+		var acc, sent, rps, p50, p95, p99, mx, errs, rej, smp, smpPct, tcpu, trss, acpu, pg, busy, lg, growth, bpe, evRows, telRows, fnd, fpm, inc []float64
+		seen := map[string]bool{}
+		for _, r := range rs {
+			if ig := r.ingest; ig != nil {
+				acc = append(acc, ig.AcceptedPerS)
+				sent = append(sent, ig.SentPerS)
+				rps = append(rps, ig.RequestsPerS)
+				p50 = append(p50, ig.Latency.P50)
+				p95 = append(p95, ig.Latency.P95)
+				p99 = append(p99, ig.Latency.P99)
+				mx = append(mx, ig.Latency.Max)
+				errs = append(errs, float64(ig.RequestErrors))
+				rej = append(rej, float64(ig.Rejected))
+				smp = append(smp, float64(ig.Sampled))
+				if ig.EventsSent > 0 {
+					smpPct = append(smpPct, float64(ig.Sampled)/float64(ig.EventsSent)*100)
+				}
+				for _, e := range ig.ErrorSamples {
+					if !seen[e] {
+						seen[e] = true
+						c.ErrorSamples = append(c.ErrorSamples, e)
+					}
+				}
+			}
+			if mon := r.monitor; mon != nil {
+				if p, ok := mon.Procs["telemetry"]; ok && p.Found {
+					tcpu = append(tcpu, p.CPUPct)
+					trss = append(trss, float64(p.RSSPeakKB)/1024)
+				}
+				if v, ok := procCPU(mon, "api"); ok {
+					acpu = append(acpu, v)
+				}
+				if v, ok := procCPU(mon, "loadgen"); ok {
+					lg = append(lg, v)
+				}
+				if cm, ok := mon.Comms["postgres"]; ok && cm.Found {
+					pg = append(pg, cm.CPUPct)
+				}
+				busy = append(busy, mon.System.BusyPct)
+			}
+			if db := r.db; db != nil {
+				d := func(k string) float64 { return db.After[k] - db.Before[k] }
+				bytes := d("telemetry_events_bytes") + d("events_bytes") + d("findings_bytes") + d("incidents_bytes")
+				growth = append(growth, bytes/1024/1024)
+				rows := d("events_rows")
+				evRows = append(evRows, rows)
+				telRows = append(telRows, d("telemetry_events_rows"))
+				if rows > 0 {
+					bpe = append(bpe, bytes/rows)
+				}
+				fnd = append(fnd, d("findings_rows"))
+				inc = append(inc, d("incidents_rows"))
+				if r.ingest != nil && r.ingest.DurationS > 0 {
+					fpm = append(fpm, d("findings_rows")/(r.ingest.DurationS/60))
+				}
+			}
+		}
+		c.AcceptedPerS, c.SentPerS, c.RequestsPerS = stat(acc), stat(sent), stat(rps)
+		c.P50Ms, c.P95Ms, c.P99Ms, c.MaxMs = stat(p50), stat(p95), stat(p99), stat(mx)
+		c.RequestErrors, c.Rejected, c.Sampled, c.SampledPct = stat(errs), stat(rej), stat(smp), stat(smpPct)
+		c.TelemetryCPUPct, c.TelemetryRSSPeakMB, c.APICPUPct, c.PostgresCPUPct, c.SystemBusyPct, c.LoadgenCPUPct = stat(tcpu), stat(trss), stat(acpu), stat(pg), stat(busy), stat(lg)
+		c.DBGrowthMB, c.BytesPerStoredEvent, c.EventsRowsStored, c.TelemetryRowsStored = stat(growth), stat(bpe), stat(evRows), stat(telRows)
+		c.Findings, c.FindingsPerMin, c.Incidents = stat(fnd), stat(fpm), stat(inc)
+		out = append(out, c)
+	}
+	return out
+}
+
+func ingestMarkdown(s *Summary) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "# Telemetry plane ingest — %s\n\n", s.GeneratedAt.Format("2006-01-02"))
+	fmt.Fprintf(&b, "%s\n\n", envLine(s.Environment))
+	fmt.Fprintf(&b, "Median of %v repetitions per cell (min–max in parentheses); %v s measured window after a %v s warm-up, batches of %v events over mTLS. "+
+		"CPU percentages are percent of one core (`ncpu` = %v). PostgreSQL runs on the same machine.\n\n",
+		s.Config["reps"], s.Config["duration_s"], s.Config["warmup_s"], s.Config["batch"], s.Environment["ncpu"])
+	b.WriteString("## Throughput and latency\n\n")
+	b.WriteString("| Config | Conc. | Sampler | AI share | Accepted events/s | Requests/s | p50 ms | p95 ms | p99 ms | max ms | Sampled (dropped by sampler) % | Rejected | Request errors |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|---|---|---|---|\n")
+	for _, c := range s.Ingest {
+		fmt.Fprintf(&b, "| %s | %d | %s | %.0f%% | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n", c.Label, c.Concurrency, c.Sampling, c.AIShare*100,
+			fmtStat(c.AcceptedPerS, 0), fmtStat(c.RequestsPerS, 1), fmtStat(c.P50Ms, 1), fmtStat(c.P95Ms, 1), fmtStat(c.P99Ms, 1), fmtStat(c.MaxMs, 0),
+			fmtStat(c.SampledPct, 1), fmtStat(c.Rejected, 0), fmtStat(c.RequestErrors, 0))
+	}
+	b.WriteString("\n## Resources and storage\n\n")
+	b.WriteString("| Config | Telemetry plane CPU % | RSS peak MB | API plane CPU % | PostgreSQL CPU % | Load generator CPU % | System busy % (all cores) | DB growth MB | bytes / stored event | events rows | findings (per min) | incidents |\n")
+	b.WriteString("|---|---|---|---|---|---|---|---|---|---|---|---|\n")
+	for _, c := range s.Ingest {
+		fmt.Fprintf(&b, "| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s (%s) | %s |\n", c.Label,
+			fmtStat(c.TelemetryCPUPct, 1), fmtStat(c.TelemetryRSSPeakMB, 1), fmtStat(c.APICPUPct, 1), fmtStat(c.PostgresCPUPct, 1), fmtStat(c.LoadgenCPUPct, 1),
+			fmtStat(c.SystemBusyPct, 1), fmtStat(c.DBGrowthMB, 1), fmtStat(c.BytesPerStoredEvent, 0), fmtStat(c.EventsRowsStored, 0),
+			fmtStat(c.Findings, 0), fmtStat(c.FindingsPerMin, 1), fmtStat(c.Incidents, 0))
+	}
+	if len(s.Notes) > 0 {
+		b.WriteString("\n## Notes\n\n")
+		for _, n := range s.Notes {
+			fmt.Fprintf(&b, "- %s\n", n)
+		}
+	}
+	return b.String()
+}
+
+// runReport aggregates <in>/runs/*/ into a summary JSON and a markdown table.
+// <in>/env.json (environment facts) and <in>/config.json (run parameters) are
+// embedded verbatim; <in>/notes.txt (one note per line) becomes the notes list.
+func runReport(args []string) error {
+	fs := flag.NewFlagSet("report", flag.ContinueOnError)
+	kind := fs.String("kind", "", "agent | ingest")
+	in := fs.String("in", "", "raw results directory (contains runs/, env.json, config.json)")
+	outJSON := fs.String("out-json", "", "summary JSON path")
+	outMD := fs.String("out-md", "", "markdown path")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if *in == "" || *outJSON == "" || *outMD == "" {
+		return errors.New("-in, -out-json and -out-md are required")
+	}
+	runs, err := loadRuns(*in)
+	if err != nil {
+		return err
+	}
+	if len(runs) == 0 {
+		return errors.New("no runs found")
+	}
+	s := &Summary{GeneratedAt: time.Now().UTC().Truncate(time.Second), Environment: map[string]any{}, Config: map[string]any{}}
+	if err := readJSONFile(filepath.Join(*in, "env.json"), &s.Environment); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := readJSONFile(filepath.Join(*in, "config.json"), &s.Config); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if b, err := os.ReadFile(filepath.Join(*in, "notes.txt")); err == nil {
+		for _, l := range strings.Split(string(b), "\n") {
+			if l = strings.TrimSpace(l); l != "" {
+				s.Notes = append(s.Notes, l)
+			}
+		}
+	}
+	var md string
+	switch *kind {
+	case "agent":
+		s.Benchmark = "agent-overhead"
+		s.Scenarios = summariseAgent(runs)
+		md = agentMarkdown(s)
+	case "ingest":
+		s.Benchmark = "backend-ingest"
+		s.Ingest = summariseIngest(runs)
+		md = ingestMarkdown(s)
+	default:
+		return errors.New("-kind must be agent or ingest")
+	}
+	if err := writeJSONFile(*outJSON, s); err != nil {
+		return err
+	}
+	if err := os.WriteFile(*outMD, []byte(md), 0o644); err != nil {
+		return err
+	}
+	fmt.Print(md)
+	return nil
+}
diff --git a/scripts/bench/loadgen/workload.go b/scripts/bench/loadgen/workload.go
new file mode 100644
index 0000000..78c8616
--- /dev/null
+++ b/scripts/bench/loadgen/workload.go
@@ -0,0 +1,225 @@
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"flag"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// GenResult is the outcome of one paced generator.
+type GenResult struct {
+	Kind          string  `json:"kind"`
+	TargetPerS    float64 `json:"target_per_s"`
+	Scheduled     int64   `json:"scheduled"`      // ticks the pacer emitted
+	Achieved      int64   `json:"achieved"`       // operations that completed successfully
+	Failed        int64   `json:"failed"`         // operations that returned an error
+	Missed        int64   `json:"missed"`         // ticks dropped because every worker was busy
+	AchievedPerS  float64 `json:"achieved_per_s"` // achieved / wall time
+	CompletionPct float64 `json:"completion_pct"` // achieved / (target_per_s * duration) * 100
+}
+
+// WorkloadResult is written by `loadgen workload --out`.
+type WorkloadResult struct {
+	Label      string      `json:"label"`
+	PID        int         `json:"pid"`
+	PPID       int         `json:"ppid"`
+	StartedAt  time.Time   `json:"started_at"`
+	DurationS  float64     `json:"duration_s"` // nominal (-duration)
+	WallS      float64     `json:"wall_s"`     // actual, including the drain of the last ticks
+	Generators []GenResult `json:"generators"`
+}
+
+type generator struct {
+	kind    string
+	rate    float64
+	workers int
+	op      func(worker, seq int) error
+}
+
+// runWorkload drives up to four paced generators for a fixed duration:
+// short-lived execs of /bin/true, opens of files under --dir, TCP connects to
+// --tcp and DNS-shaped UDP datagrams to --udp. Each generator is a pacer that
+// emits one tick per 1/rate seconds into a small queue served by a worker
+// pool; when the pool cannot keep up the tick is counted as missed instead of
+// building an unbounded backlog, so "achieved" is an honest completion figure.
+func runWorkload(args []string) error {
+	fs := flag.NewFlagSet("workload", flag.ContinueOnError)
+	duration := fs.Duration("duration", 60*time.Second, "how long to run")
+	execRate := fs.Float64("exec", 0, "process execs (/bin/true) per second")
+	fileRate := fs.Float64("file", 0, "file opens per second (files under -dir)")
+	connRate := fs.Float64("connect", 0, "TCP connects per second (to -tcp)")
+	dnsRate := fs.Float64("dns", 0, "DNS-like UDP sends per second (to -udp)")
+	dir := fs.String("dir", "", "directory for the files opened by the file generator (created if missing)")
+	nfiles := fs.Int("files", 64, "number of distinct files to cycle through")
+	tcp := fs.String("tcp", "127.0.0.1:0", "TCP target address")
+	udp := fs.String("udp", "127.0.0.1:53", "UDP target address")
+	execWorkers := fs.Int("exec-workers", 16, "worker goroutines for the exec generator")
+	workers := fs.Int("workers", 4, "worker goroutines for the other generators")
+	label := fs.String("label", "workload", "label stored in the result")
+	out := fs.String("out", "", "result JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	var gens []generator
+	if *execRate > 0 {
+		gens = append(gens, generator{kind: "exec", rate: *execRate, workers: *execWorkers, op: func(int, int) error {
+			cmd := exec.Command("/bin/true")
+			return cmd.Run()
+		}})
+	}
+	if *fileRate > 0 {
+		if *dir == "" {
+			return errors.New("-file needs -dir")
+		}
+		if err := os.MkdirAll(*dir, 0o755); err != nil {
+			return err
+		}
+		// Files are created only when missing so the harness can pre-create
+		// them outside the measured window (creating is an open too).
+		paths := make([]string, *nfiles)
+		for i := range paths {
+			paths[i] = filepath.Join(*dir, fmt.Sprintf("bench-%03d.txt", i))
+			if _, err := os.Stat(paths[i]); err != nil {
+				if err := os.WriteFile(paths[i], []byte("correlic benchmark file\n"), 0o644); err != nil {
+					return err
+				}
+			}
+		}
+		gens = append(gens, generator{kind: "file", rate: *fileRate, workers: *workers, op: func(_, seq int) error {
+			f, err := os.Open(paths[seq%len(paths)])
+			if err != nil {
+				return err
+			}
+			return f.Close()
+		}})
+	}
+	if *connRate > 0 {
+		addr := *tcp
+		gens = append(gens, generator{kind: "connect", rate: *connRate, workers: *workers, op: func(int, int) error {
+			c, err := net.DialTimeout("tcp", addr, 2*time.Second)
+			if err != nil {
+				return err
+			}
+			if tc, ok := c.(*net.TCPConn); ok {
+				_ = tc.SetLinger(0) // RST on close: no TIME_WAIT pile-up at hundreds of connects/s
+			}
+			return c.Close()
+		}})
+	}
+	if *dnsRate > 0 {
+		conns := make([]*net.UDPConn, *workers)
+		raddr, err := net.ResolveUDPAddr("udp", *udp)
+		if err != nil {
+			return err
+		}
+		for i := range conns {
+			c, err := net.DialUDP("udp", nil, raddr)
+			if err != nil {
+				return fmt.Errorf("udp dial: %w", err)
+			}
+			conns[i] = c
+			defer c.Close()
+		}
+		gens = append(gens, generator{kind: "dns", rate: *dnsRate, workers: *workers, op: func(worker, seq int) error {
+			_, err := conns[worker].Write(dnsQuery(uint16(seq), fmt.Sprintf("bench%d.example.com", seq%100)))
+			return err
+		}})
+	}
+	if len(gens) == 0 {
+		return errors.New("no generator enabled (set -exec/-file/-connect/-dns)")
+	}
+
+	res := WorkloadResult{Label: *label, PID: os.Getpid(), PPID: os.Getppid(), StartedAt: time.Now()}
+	results := make([]GenResult, len(gens))
+	var wg sync.WaitGroup
+	start := time.Now()
+	for i, g := range gens {
+		wg.Add(1)
+		go func(i int, g generator) {
+			defer wg.Done()
+			results[i] = runGenerator(g, start, *duration)
+		}(i, g)
+	}
+	wg.Wait()
+	res.DurationS = duration.Seconds()
+	res.WallS = time.Since(start).Seconds()
+	res.Generators = results
+	return writeJSONFile(*out, res)
+}
+
+func runGenerator(g generator, start time.Time, d time.Duration) GenResult {
+	r := GenResult{Kind: g.kind, TargetPerS: g.rate}
+	var achieved, failed atomic.Int64
+	work := make(chan int, g.workers*2)
+	var wg sync.WaitGroup
+	for w := 0; w < g.workers; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for seq := range work {
+				if err := g.op(w, seq); err != nil {
+					failed.Add(1)
+				} else {
+					achieved.Add(1)
+				}
+			}
+		}(w)
+	}
+	interval := time.Duration(float64(time.Second) / g.rate)
+	end := start.Add(d)
+	for seq := 0; ; seq++ {
+		next := start.Add(time.Duration(seq) * interval)
+		if !next.Before(end) {
+			break
+		}
+		if wait := time.Until(next); wait > 0 {
+			time.Sleep(wait)
+		}
+		r.Scheduled++
+		select {
+		case work <- seq:
+		default:
+			r.Missed++
+		}
+	}
+	close(work)
+	wg.Wait()
+	r.Achieved = achieved.Load()
+	r.Failed = failed.Load()
+	// Ticks are spread over [0, d), so rates are per nominal second: a run
+	// whose last tick lands early must not look faster than its target.
+	r.AchievedPerS = float64(r.Achieved) / d.Seconds()
+	if want := g.rate * d.Seconds(); want > 0 {
+		r.CompletionPct = float64(r.Achieved) / want * 100
+	}
+	return r
+}
+
+// dnsQuery builds a minimal, well-formed DNS A query so the agent's DNS
+// program can parse the name from the datagram.
+func dnsQuery(id uint16, name string) []byte {
+	b := make([]byte, 12, 12+len(name)+6)
+	binary.BigEndian.PutUint16(b[0:], id)
+	binary.BigEndian.PutUint16(b[2:], 0x0100) // standard query, recursion desired
+	binary.BigEndian.PutUint16(b[4:], 1)      // QDCOUNT
+	label := 0
+	for i := 0; i <= len(name); i++ {
+		if i == len(name) || name[i] == '.' {
+			b = append(b, byte(i-label))
+			b = append(b, name[label:i]...)
+			label = i + 1
+		}
+	}
+	b = append(b, 0)          // root label
+	b = append(b, 0, 1, 0, 1) // QTYPE A, QCLASS IN
+	return b
+}
