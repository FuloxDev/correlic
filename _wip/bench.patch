+func loadRuns(dir string) ([]rawRun, error) {
+	entries, err := os.ReadDir(filepath.Join(dir, "runs"))
+	if err != nil {
+		return nil, err
+	}
+	var runs []rawRun
+	for _, e := range entries {
+		if !e.IsDir() {
+			continue
+		}
+		r := rawRun{dir: filepath.Join(dir, "runs", e.Name())}
+		if err := readJSONFile(filepath.Join(r.dir, "meta.json"), &r.meta); err != nil {
+			return nil, fmt.Errorf("%s: %w", r.dir, err)
+		}
+		optional := func(name string, v any) error {
+			err := readJSONFile(filepath.Join(r.dir, name), v)
+			if errors.Is(err, os.ErrNotExist) {
+				return nil
+			}
+			return err
+		}
+		var m MonitorResult
+		if err := optional("monitor.json", &m); err != nil {
+			return nil, fmt.Errorf("%s: %w", r.dir, err)
+		}
+		if m.Procs != nil {
+			r.monitor = &m
+		}
+		var ai, noise WorkloadResult
+		if err := optional("workload-ai.json", &ai); err != nil {
+			return nil, err
+		}
+		if ai.Generators != nil {
+			r.ai = &ai
+		}
+		if err := optional("workload-noise.json", &noise); err != nil {
+			return nil, err
+		}
+		if noise.Generators != nil {
+			r.noise = &noise
+		}
+		var al AgentLogSummary
+		if err := optional("agentlog.json", &al); err != nil {
+			return nil, err
+		}
+		if al.RateLimited != nil {
+			r.agentLog = &al
+		}
+		var ig IngestResult
+		if err := optional("ingest.json", &ig); err != nil {
+			return nil, err
+		}
+		if ig.Concurrency > 0 {
+			r.ingest = &ig
+		}
+		var db dbCounts
+		if err := optional("db.json", &db); err != nil {
+			return nil, err
+		}
+		if db.Before != nil {
+			r.db = &db
+		}
+		runs = append(runs, r)
+	}
+	sort.Slice(runs, func(i, j int) bool { return runs[i].dir < runs[j].dir })
+	return runs, nil
+}
+
