+
+func procCPU(m *MonitorResult, name string) (float64, bool) {
+	if m == nil {
+		return 0, false
+	}
+	if p, ok := m.Procs[name]; ok && p.Found {
+		return p.CPUPct, true
+	}
+	return 0, false
+}
+
+func workloadTotals(ws ...*WorkloadResult) (target, achieved float64, missed, failed float64, kinds map[string]*[5]float64) {
+	kinds = map[string]*[5]float64{} // target, achieved_per_s, missed, failed, achieved
+	for _, w := range ws {
+		if w == nil {
+			continue
+		}
+		for _, g := range w.Generators {
+			target += g.TargetPerS * w.DurationS
+			achieved += float64(g.Achieved)
+			missed += float64(g.Missed)
+			failed += float64(g.Failed)
+			k := kinds[g.Kind]
+			if k == nil {
+				k = &[5]float64{}
+				kinds[g.Kind] = k
+			}
+			k[0] += g.TargetPerS
+			k[1] += g.AchievedPerS
+			k[2] += float64(g.Missed)
+			k[3] += float64(g.Failed)
+			k[4] += float64(g.Achieved)
+		}
+	}
+	return
+}
+
+func summariseAgentMode(runs []rawRun) *AgentModeSummary {
+	if len(runs) == 0 {
+		return nil
+	}
+	s := &AgentModeSummary{Runs: len(runs), Kinds: map[string]KindSummary{}, EventsStoredByType: map[string]Stat{}, TreeEventsByType: map[string]Stat{}, AIOpsByKind: map[string]Stat{}, CaptureByTypePct: map[string]Stat{}}
+	var cpu, user, sys, peak, rss, hwm, bpfCPU, bpfRuns, bpfRunsPerS, backend, pg, busy, cores, sysPct []float64
+	var compl, achievedPerS, aiCompl, noiseCompl, rl, bf, dd, ec, warn, stored, aiOps []float64
+	kindVals := map[string]*[5][]float64{} // target, achieved/s, completion, missed, failed
+	byType := map[string][]float64{}
+	aiByKind := map[string][]float64{}
+	treeByType := map[string][]float64{}
+	captureByType := map[string][]float64{}
+	progVals := map[string]*BPFProgSummary{}
+	progRuns := map[string][]float64{}
+	progNs := map[string][]float64{}
+	seenWarn := map[string]bool{}
+	for _, r := range runs {
+		m := r.monitor
+		if m != nil {
+			if p, ok := m.Procs["agent"]; ok && p.Found {
+				cpu = append(cpu, p.CPUPct)
+				user = append(user, p.UserPct)
+				sys = append(sys, p.SysPct)
+				peak = append(peak, p.CPUPctPeak1s)
+				rss = append(rss, float64(p.RSSPeakKB)/1024)
+				hwm = append(hwm, float64(p.VmHWMKB)/1024)
+			}
+			if m.BPF != nil && m.BPF.Error == "" {
+				bpfCPU = append(bpfCPU, m.BPF.CPUPct)
+				bpfRuns = append(bpfRuns, float64(m.BPF.TotalRunCount))
+				if m.DurationS > 0 {
+					bpfRunsPerS = append(bpfRunsPerS, float64(m.BPF.TotalRunCount)/m.DurationS)
+				}
+				for _, p := range m.BPF.Programs {
+					key := p.Name + "/" + p.Type
+					if progVals[key] == nil {
+						progVals[key] = &BPFProgSummary{Name: p.Name, Type: p.Type}
+					}
+					progRuns[key] = append(progRuns[key], float64(p.RunCount))
+					progNs[key] = append(progNs[key], float64(p.RunTimeNs))
+				}
+			}
+			var be float64
+			var any bool
+			for _, n := range []string{"api", "telemetry"} {
+				if v, ok := procCPU(m, n); ok {
+					be += v
+					any = true
+				}
+			}
+			if any {
+				backend = append(backend, be)
+			}
+			if c, ok := m.Comms["postgres"]; ok && c.Found {
+				pg = append(pg, c.CPUPct)
+			}
+			busy = append(busy, m.System.BusyPct)
+			cores = append(cores, m.System.BusyCores)
+			sysPct = append(sysPct, m.System.SysPct)
+		}
+		target, achieved, _, _, kinds := workloadTotals(r.ai, r.noise)
+		if target > 0 {
+			compl = append(compl, achieved/target*100)
+			dur := r.meta.DurationS
+			if r.ai != nil {
+				dur = r.ai.DurationS
+			}
+			if dur > 0 {
+				achievedPerS = append(achievedPerS, achieved/dur)
+			}
+		}
+		aiKinds := map[string]float64{}
+		if t, a, _, _, ak := workloadTotals(r.ai); t > 0 {
+			aiCompl = append(aiCompl, a/t*100)
+			aiOps = append(aiOps, a)
+			for k, v := range ak {
+				aiKinds[k] = v[4]
+				aiByKind[k] = append(aiByKind[k], v[4])
+			}
+		}
+		if t, a, _, _, _ := workloadTotals(r.noise); t > 0 {
+			noiseCompl = append(noiseCompl, a/t*100)
+		}
+		for k, v := range kinds {
+			kv := kindVals[k]
+			if kv == nil {
+				kv = &[5][]float64{}
+				kindVals[k] = kv
+			}
+			kv[0] = append(kv[0], v[0])
+			kv[1] = append(kv[1], v[1])
+			if v[0] > 0 {
+				kv[2] = append(kv[2], v[1]/v[0]*100)
+			}
+			kv[3] = append(kv[3], v[2])
+			kv[4] = append(kv[4], v[3])
+		}
+		if al := r.agentLog; al != nil {
+			rl = append(rl, sumMap(al.RateLimited))
+			bf = append(bf, sumMap(al.BufferFull))
+			dd = append(dd, float64(al.Deduplicated))
+			ec = append(ec, sumMap(al.ExecCleanup))
+			warn = append(warn, float64(al.Warn+al.Error))
+			for _, w := range al.WarnSamples {
+				if !seenWarn[w] {
+					seenWarn[w] = true
+					s.AgentWarnSamples = append(s.AgentWarnSamples, w)
+				}
+			}
+		}
+		if r.db != nil {
+			var total float64
+			for t, after := range r.db.After {
+				d := after - r.db.Before[t]
+				byType[t] = append(byType[t], d)
+				total += d
+			}
+			stored = append(stored, total)
+			for t, n := range r.db.Tree {
+				treeByType[t] = append(treeByType[t], n)
+				if ops := aiKinds[eventKind[t]]; ops > 0 {
+					captureByType[t] = append(captureByType[t], n/ops*100)
+				}
+			}
+		}
+	}
+	s.AgentCPUPct, s.AgentUserPct, s.AgentSysPct, s.AgentCPUPeak1sPct = stat(cpu), stat(user), stat(sys), stat(peak)
+	s.AgentRSSPeakMB, s.AgentVmHWMMB = stat(rss), stat(hwm)
+	s.BPFCPUPct, s.BPFRunCount, s.BPFRunsPerS = stat(bpfCPU), stat(bpfRuns), stat(bpfRunsPerS)
+	for key, p := range progVals {
+		p.RunCount = stat(progRuns[key])
+		p.RunTimeNs = stat(progNs[key])
+		var avg []float64
+		for i := range progRuns[key] {
+			if progRuns[key][i] > 0 {
+				avg = append(avg, progNs[key][i]/progRuns[key][i])
+			}
+		}
+		p.AvgNs = stat(avg)
+		s.BPFPrograms = append(s.BPFPrograms, *p)
+	}
+	sort.Slice(s.BPFPrograms, func(i, j int) bool { return s.BPFPrograms[i].RunTimeNs.Median > s.BPFPrograms[j].RunTimeNs.Median })
+	s.BackendCPUPct, s.PostgresCPUPct = stat(backend), stat(pg)
+	s.SystemBusyPct, s.SystemBusyCores, s.SystemSysPct = stat(busy), stat(cores), stat(sysPct)
+	s.WorkloadCompletionPct, s.WorkloadAchievedPerS = stat(compl), stat(achievedPerS)
+	s.AICompletionPct, s.NoiseCompletionPct = stat(aiCompl), stat(noiseCompl)
+	for k, v := range kindVals {
+		ks := KindSummary{AchievedPerS: stat(v[1]), CompletionPct: stat(v[2]), Missed: stat(v[3]), Failed: stat(v[4])}
+		if len(v[0]) > 0 {
+			ks.TargetPerS = v[0][0]
+		}
+		s.Kinds[k] = ks
+	}
+	s.DropsRateLimited, s.DropsBufferFull, s.DropsDeduplicated, s.DropsExecCleanup = stat(rl), stat(bf), stat(dd), stat(ec)
+	s.AgentWarnLines = stat(warn)
+	s.EventsStored = stat(stored)
+	for t, v := range byType {
+		s.EventsStoredByType[t] = stat(v)
+	}
+	s.AIOpsGenerated = stat(aiOps)
+	for k, v := range aiByKind {
+		s.AIOpsByKind[k] = stat(v)
+	}
+	for t, v := range treeByType {
+		s.TreeEventsByType[t] = stat(v)
+	}
+	for t, v := range captureByType {
+		s.CaptureByTypePct[t] = stat(v)
+	}
+	return s
+}
+
+func sumMap(m map[string]int64) float64 {
+	var t float64
+	for _, v := range m {
+		t += float64(v)
+	}
+	return t
+}
+
+func pairDelta(with, without []rawRun, f func(rawRun) (float64, bool)) Stat {
+	var vals []float64
+	for _, a := range with {
+		for _, b := range without {
+			if a.meta.Rep != b.meta.Rep {
+				continue
+			}
+			va, oka := f(a)
+			vb, okb := f(b)
+			if oka && okb {
+				vals = append(vals, va-vb)
+			}
+		}
+	}
+	return stat(vals)
+}
+
+func summariseAgent(runs []rawRun) []AgentScenarioSummary {
+	byScenario := map[string][]rawRun{}
+	for _, r := range runs {
+		byScenario[r.meta.Scenario] = append(byScenario[r.meta.Scenario], r)
+	}
+	var names []string
+	for n := range byScenario {
+		names = append(names, n)
+	}
+	sort.Slice(names, func(i, j int) bool {
+		oi, oki := scenarioOrder[names[i]]
+		oj, okj := scenarioOrder[names[j]]
+		if oki && okj {
+			return oi < oj
+		}
+		if oki != okj {
+			return oki
+		}
+		return names[i] < names[j]
+	})
+	var out []AgentScenarioSummary
+	for _, n := range names {
+		rs := byScenario[n]
+		var with, without []rawRun
+		for _, r := range rs {
+			if r.meta.Mode == "agent" {
+				with = append(with, r)
+			} else {
+				without = append(without, r)
+			}
+		}
+		sc := AgentScenarioSummary{Name: n, Rates: rs[0].meta.Rates, AIShare: rs[0].meta.AIShare,
+			WithAgent: summariseAgentMode(with), WithoutAgent: summariseAgentMode(without)}
+		if len(with) > 0 && len(without) > 0 {
+			sc.Delta = &AgentDelta{
+				SystemBusyPct: pairDelta(with, without, func(r rawRun) (float64, bool) {
+					return r.monitor.System.BusyPct, r.monitor != nil
+				}),
+				SystemBusyCores: pairDelta(with, without, func(r rawRun) (float64, bool) {
+					return r.monitor.System.BusyCores, r.monitor != nil
+				}),
+				WorkloadCompletionPct: pairDelta(with, without, func(r rawRun) (float64, bool) {
+					t, a, _, _, _ := workloadTotals(r.ai, r.noise)
+					return a / t * 100, t > 0
+				}),
+			}
+			sc.Delta.WorkloadAchievedPct = pairDelta(with, without, func(r rawRun) (float64, bool) {
+				t, a, _, _, _ := workloadTotals(r.ai, r.noise)
+				return a / t * 100, t > 0
+			})
+		}
+		out = append(out, sc)
+	}
+	return out
+}
