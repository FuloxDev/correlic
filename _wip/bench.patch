--- /dev/null
+++ b/scripts/bench/agent-overhead.sh
@@ -0,0 +1,215 @@
+#!/usr/bin/env bash
+# Agent overhead benchmark: CPU, memory, eBPF kernel time, drops and the
+# whole-machine cost of running the Correlic Linux agent while a synthetic
+# workload runs inside a fake AI process tree and outside it.
+#
+# usage: scripts/bench/agent-overhead.sh [--detach] [--duration 60] [--reps 3] [--warmup 10]
+#          [--scenarios idle,light,moderate,heavy] [--ai-share 0.5] [--out scripts/bench/results]
+#
+# Needs root, a kernel with BTF, PostgreSQL (see lib.sh for BENCH_* knobs) and
+# a free UDP port 53 on 127.0.0.1. --detach re-launches the script under
+# setsid -f (reparented to pid 1, log in $BENCH_WORK/agent-overhead.log): use
+# it when starting from an AI coding tool's shell, otherwise the agent would
+# attribute the whole benchmark to that tool (the script checks and explains).
+set -euo pipefail
+ORIG_ARGS="$*"
+# shellcheck source=lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+
+DURATION=60; REPS=3; WARMUP=10; SCENARIOS="idle,light,moderate,heavy"; AI_SHARE=0.5; OUT="$BENCH_DIR/results"; DETACH=0
+PASS=()
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --detach) DETACH=1; shift;;
+    --duration) DURATION=$2; PASS+=("$1" "$2"); shift 2;;
+    --reps) REPS=$2; PASS+=("$1" "$2"); shift 2;;
+    --warmup) WARMUP=$2; PASS+=("$1" "$2"); shift 2;;
+    --scenarios) SCENARIOS=$2; PASS+=("$1" "$2"); shift 2;;
+    --ai-share) AI_SHARE=$2; PASS+=("$1" "$2"); shift 2;;
+    --out) OUT=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); PASS+=("$1" "$OUT"); shift 2;;
+    -h|--help) sed -n '2,14p' "$0"; exit 0;;
+    *) die "unknown argument $1";;
+  esac
+done
+if [ "$DETACH" = 1 ]; then
+  mkdir -p "$WORK"
+  # setsid -f forks and its parent exits at once, so the benchmark is reparented
+  # to pid 1 and no ancestor of it is an AI tool's shell.
+  setsid -f bash "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" "${PASS[@]}" >"$WORK/agent-overhead.log" 2>&1
+  echo "detached; progress: tail -f $WORK/agent-overhead.log"
+  exit 0
+fi
+# Files for the file-open generator. The agent's file-open BPF program only
+# emits opens of paths under /home/ (or credential-like paths), which is where
+# a developer's project lives, so the files go there and are removed at exit.
+FILES="${BENCH_FILES_DIR:-/home/correlic-bench}"
+
+# scenario -> "exec file connect dns" events per second (total over both trees)
+scenario_rates() {
+  case "$1" in
+    idle) echo "0 0 0 0";;
+    light) echo "10 10 5 5";;
+    moderate) echo "100 100 50 20";;
+    heavy) echo "1000 500 200 50";;
+    *) die "unknown scenario $1";;
+  esac
+}
+
+bench_preflight
+bench_check_ancestry
+[ -e "$FILES" ] && die "$FILES exists; remove it or set BENCH_FILES_DIR"
+DB=bench_agent
+RAW="$WORK/agent-overhead"
+CERTS="$WORK/agent-certs"
+LOADGEN="$BIN/loadgen"
+rm -rf "$RAW"; mkdir -p "$RAW/runs" "$OUT"
+: >"$PIDFILE"
+
+BPF_STATS_PREV=$(cat /proc/sys/kernel/bpf_stats_enabled 2>/dev/null || echo 0)
+cleanup() {
+  log "cleanup"
+  [ -n "${AGENT_PID:-}" ] && kill "$AGENT_PID" 2>/dev/null || true
+  bench_planes_down
+  bench_kill_all
+  echo "$BPF_STATS_PREV" >/proc/sys/kernel/bpf_stats_enabled 2>/dev/null || true
+  rm -rf "$FILES"
+}
+trap cleanup EXIT
+
+bench_build
+bench_db_reset "$DB"
+bench_bootstrap "$DB" "$CERTS"
+bench_planes_up "$DB" "$CERTS" "$RAW"
+
+mountpoint -q /sys/kernel/tracing || mount -t tracefs nodev /sys/kernel/tracing || true
+echo 1 >/proc/sys/kernel/bpf_stats_enabled
+
+# Local sinks for the connect/dns generators (outside the AI tree).
+"$LOADGEN" listen -tcp 127.0.0.1:0 -udp 127.0.0.1:53 -ready-file "$RAW/listen.ready" >"$RAW/listen.log" 2>&1 &
+LISTEN_PID=$!; echo "$LISTEN_PID" >>"$PIDFILE"
+for i in $(seq 1 20); do [ -s "$RAW/listen.ready" ] && break; kill -0 "$LISTEN_PID" 2>/dev/null || die "listener failed (is UDP 127.0.0.1:53 free?): $(cat "$RAW/listen.log")"; sleep 0.25; done
+TCP_PORT=$(sed -nE 's/.*tcp=([0-9]+).*/\1/p' "$RAW/listen.ready")
+log "sinks: tcp 127.0.0.1:$TCP_PORT, udp 127.0.0.1:53"
+
+# The fake AI root: a bash whose argv[0] is "claude" (matches the seeded AI
+# pattern, exactly like the real CLI would) running the generator as a child.
+AI_ROOT="$WORK/ai-root.sh"
+cat >"$AI_ROOT" <<'SH'
+#!/usr/bin/env bash
+exec -a claude bash -c '"$@"' _ "$@"
+SH
+chmod +x "$AI_ROOT"
+
+bench_env_json "$RAW/env.json"
+AGENT_ID_FILE="$CERTS/.correlic-agent-id"
+cat >"$RAW/config.json" <<JSON
+{"duration_s": $DURATION, "reps": $REPS, "warmup_s": $WARMUP, "ai_share": $AI_SHARE,
+ "scenarios": {"idle": [0,0,0,0], "light": [10,10,5,5], "moderate": [100,100,50,20], "heavy": [1000,500,200,50]},
+ "rates_order": ["exec","file","connect","dns"],
+ "agent_env": {"AGENT_DISPATCH_BUFFER": "${AGENT_DISPATCH_BUFFER:-default 50000}", "AGENT_EXEC_RATE_LIMIT": "${AGENT_EXEC_RATE_LIMIT:-default 200}", "AGENT_EXEC_DEDUPE_WINDOW_MS": "${AGENT_EXEC_DEDUPE_WINDOW_MS:-default 500}"},
+ "backend_env": {"CORRELIC_DISABLE_RATE_LIMIT": "1", "SAMPLING_ENABLED": "default"}}
+JSON
+cat >"$RAW/notes.txt" <<TXT
+Rates are the total over both trees; each run splits them $AI_SHARE / $(awk "BEGIN{print 1-$AI_SHARE}") between the fake AI tree (argv[0]=claude) and a plain noise tree. Exec = /bin/true; file = open+close of 64 files under /home/correlic-bench (the file-open BPF program only emits opens under /home/ or of credential-like paths, everything else is dropped in the kernel); connect = TCP connect+close to a local listener; dns = one DNS A query datagram to 127.0.0.1:53.
+"Agent CPU" is the agent process only (utime+stime from /proc, all threads). "eBPF kernel time" is the kernel's own run-time accounting of the agent's BPF programs (bpf_stats_enabled=1); it is charged to the workload's system time, not to the agent process, so it is listed separately.
+The BPF programs do not count failed bpf_ringbuf_reserve() calls, so ring-buffer overflow is not observable; the per-type capture figure (events stored at the backend whose actor is the fake tree / operations the fake tree performed) is the end-to-end number and includes the dispatcher's intentional drops (exec rate limit, 500 ms exec dedupe, helper-exec cleanup). "Events stored, all sessions" also contains whatever other AI sessions the agent tracked on the host during the run.
+The connect generator's figure includes the UDP socket connects of the dns generator (one per worker).
+Dispatcher drop counters come from the agent's 30 s "agent drop stats" log lines; each run waits for the tick after the workload before stopping the agent.
+The backend planes and PostgreSQL run on the same machine in both modes; the planes' CPU is reported separately and everything is part of "system busy". The monitor itself reads 2 /proc files per tracked process per second (about 6 opens/s), which the file-open program sees.
+TXT
+
+host_event_counts() { # prints "type count" lines, all sessions
+  psql_ -d "$DB" -tA -F' ' -c "select type, count(*) from events group by type order by type"
+}
+tree_event_counts() { # <pid> <since>: events whose actor is the fake AI root or one of its direct children
+  psql_ -d "$DB" -tA -F' ' -c "select type, count(*) from events where ts >= '$2' and ((actor->>'pid')::bigint = $1 or (actor->>'ppid')::bigint = $1) group by type order by type"
+}
+prepare_files() { # the generator opens these; creating them here keeps the creates out of the measured window
+  local d i
+  for d in "$FILES/ai" "$FILES/noise"; do
+    mkdir -p "$d"
+    for i in $(seq 0 63); do printf 'correlic benchmark file\n' >"$d/bench-$(printf %03d "$i").txt"; done
+  done
+}
+counts_to_json() { # stdin "type count" -> JSON object
+  awk 'BEGIN{printf "{"} {printf "%s\"%s\": %s", (n++?", ":""), $1, $2} END{printf "}\n"}'
+}
+
+run_one() { # <scenario> <mode agent|noagent> <rep>
+  local scenario=$1 mode=$2 rep=$3
+  local run="$RAW/runs/$scenario-$mode-r$rep"
+  mkdir -p "$run"
+  read -r R_EXEC R_FILE R_CONN R_DNS <<<"$(scenario_rates "$scenario")"
+  local ai_exec ai_file ai_conn ai_dns no_exec no_file no_conn no_dns
+  ai_exec=$(awk "BEGIN{print $R_EXEC*$AI_SHARE}"); ai_file=$(awk "BEGIN{print $R_FILE*$AI_SHARE}"); ai_conn=$(awk "BEGIN{print $R_CONN*$AI_SHARE}"); ai_dns=$(awk "BEGIN{print $R_DNS*$AI_SHARE}")
+  no_exec=$(awk "BEGIN{print $R_EXEC*(1-$AI_SHARE)}"); no_file=$(awk "BEGIN{print $R_FILE*(1-$AI_SHARE)}"); no_conn=$(awk "BEGIN{print $R_CONN*(1-$AI_SHARE)}"); no_dns=$(awk "BEGIN{print $R_DNS*(1-$AI_SHARE)}")
+  log "=== $scenario / $mode / rep $rep (exec $R_EXEC, file $R_FILE, connect $R_CONN, dns $R_DNS per s)"
+
+  AGENT_PID=""
+  local agent_start=0 procs=(-proc "api=$API_PID" -proc "telemetry=$TEL_PID") bpf=()
+  if [ "$mode" = agent ]; then
+    agent_start=$(date +%s)
+    CORRELIC_AGENT_ID="$(cat "$AGENT_ID_FILE" 2>/dev/null || true)" "$BIN/correlic-agent" --config "$CERTS/agent.yaml" >"$run/agent.log" 2>&1 &
+    AGENT_PID=$!; echo "$AGENT_PID" >>"$PIDFILE"
+    sleep "$WARMUP"
+    kill -0 "$AGENT_PID" 2>/dev/null || die "agent exited during warm-up: $(tail -5 "$run/agent.log")"
+    grep -q "live ingestion enabled" "$run/agent.log" || log "WARNING: agent log has no 'live ingestion enabled' line"
+    procs+=(-proc "agent=$AGENT_PID")
+    bpf=(-bpf -bpf-pid "$AGENT_PID") # only this agent's programs: another loader on the host must not be counted
+  fi
+
+  prepare_files
+  host_event_counts >"$run/db-before.txt"
+  local started_at; started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+  # No -comm postgres here: scanning /proc for it would add ~150 file opens/s that the eBPF programs see.
+  "$LOADGEN" monitor -duration "${DURATION}s" "${procs[@]}" "${bpf[@]}" -out "$run/monitor.json" &
+  local mon=$!
+  local ai_pid="" noise_pid=""
+  if [ "$scenario" != idle ]; then
+    "$AI_ROOT" "$LOADGEN" workload -duration "${DURATION}s" -exec "$ai_exec" -file "$ai_file" -connect "$ai_conn" -dns "$ai_dns" \
+      -dir "$FILES/ai" -tcp "127.0.0.1:$TCP_PORT" -udp 127.0.0.1:53 -label ai -out "$run/workload-ai.json" >"$run/workload-ai.log" 2>&1 &
+    ai_pid=$!
+    "$LOADGEN" workload -duration "${DURATION}s" -exec "$no_exec" -file "$no_file" -connect "$no_conn" -dns "$no_dns" \
+      -dir "$FILES/noise" -tcp "127.0.0.1:$TCP_PORT" -udp 127.0.0.1:53 -label noise -out "$run/workload-noise.json" >"$run/workload-noise.log" 2>&1 &
+    noise_pid=$!
+  fi
+  [ -n "$ai_pid" ] && { wait "$ai_pid" || log "WARNING: AI-tree workload failed: $(cat "$run/workload-ai.log")"; }
+  [ -n "$noise_pid" ] && { wait "$noise_pid" || log "WARNING: noise workload failed: $(cat "$run/workload-noise.log")"; }
+  wait "$mon" || die "monitor failed"
+
+  if [ "$mode" = agent ]; then
+    # Wait for the dispatcher's next 30 s stats tick (+ flush), then stop the agent.
+    local el rem; el=$(( $(date +%s) - agent_start )); rem=$(( 30 - el % 30 ))
+    sleep $(( rem + 3 ))
+    kill -0 "$AGENT_PID" 2>/dev/null || log "WARNING: agent exited during the run: $(tail -3 "$run/agent.log")"
+    kill "$AGENT_PID" 2>/dev/null || true
+    wait_pid_timeout "$AGENT_PID" 15 || { log "WARNING: agent did not stop in 15 s, killing"; kill -9 "$AGENT_PID" 2>/dev/null || true; }
+    AGENT_PID=""
+    "$LOADGEN" agentlog -file "$run/agent.log" -out "$run/agentlog.json"
+    [ -f "$AGENT_ID_FILE" ] || cp "$CERTS/.correlic-agent-id" "$AGENT_ID_FILE" 2>/dev/null || true
+  fi
+  host_event_counts >"$run/db-after.txt"
+  # The fake root (exec -a claude bash -c '"$@"') execs straight into loadgen, so $ai_pid is the generator's pid.
+  if [ -n "$ai_pid" ] && [ "$mode" = agent ]; then tree_event_counts "$ai_pid" "$started_at" >"$run/db-tree.txt"; else : >"$run/db-tree.txt"; fi
+  printf '{"before": %s, "after": %s, "tree": %s}\n' "$(counts_to_json <"$run/db-before.txt")" "$(counts_to_json <"$run/db-after.txt")" "$(counts_to_json <"$run/db-tree.txt")" >"$run/db.json"
+  cat >"$run/meta.json" <<JSON
+{"scenario": "$scenario", "mode": "$mode", "rep": $rep, "duration_s": $DURATION, "ai_share": $AI_SHARE, "started_at": "$started_at",
+ "rates": {"exec": $R_EXEC, "file": $R_FILE, "connect": $R_CONN, "dns": $R_DNS}}
+JSON
+  sleep 2
+}
+
+IFS=, read -ra SCEN <<<"$SCENARIOS"
+for rep in $(seq 1 "$REPS"); do
+  for sc in "${SCEN[@]}"; do
+    for mode in agent noagent; do
+      run_one "$sc" "$mode" "$rep"
+    done
+  done
+done
+
+# Collectors that could not attach on this kernel are part of the result.
+grep -h "runner init failed" "$RAW"/runs/*/agent.log 2>/dev/null | sed -nE 's/.*msg="([^"]*)".*error="(.{0,110}).*/Agent WARN in every run: \1: \2.../p' | sort -u >>"$RAW/notes.txt" || true
+log "aggregating"
+"$LOADGEN" report -kind agent -in "$RAW" -out-json "$OUT/agent-overhead.json" -out-md "$OUT/agent-overhead.md"
+log "summary written to $OUT/agent-overhead.{json,md}; raw runs in $RAW/runs"
diff --git a/scripts/bench/backend-ingest.sh b/scripts/bench/backend-ingest.sh
new file mode 100755
index 0000000..00bf80e
--- /dev/null
+++ b/scripts/bench/backend-ingest.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# Telemetry plane ingest benchmark: synthetic canonical event batches are
+# POSTed to /ingest/events over mTLS with the agent key at several
+# concurrency levels; reports accepted events/s, latency percentiles, plane
+# CPU/RSS, PostgreSQL CPU and growth, and detection findings.
+#
+# usage: scripts/bench/backend-ingest.sh [--duration 30] [--reps 3] [--warmup 2]
+#          [--concurrency 1,8,32] [--batch 100] [--out scripts/bench/results]
+#
+# Needs PostgreSQL (see lib.sh for BENCH_* knobs). Runs as root only because
+# lib.sh's preflight is shared; the agent is not started here.
+set -euo pipefail
+ORIG_ARGS="$*"
+# shellcheck source=lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+
+DURATION=30; REPS=3; WARMUP=2; CONCURRENCY="1,8,32"; BATCH=100; OUT="$BENCH_DIR/results"
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --duration) DURATION=$2; shift 2;;
+    --reps) REPS=$2; shift 2;;
+    --warmup) WARMUP=$2; shift 2;;
+    --concurrency) CONCURRENCY=$2; shift 2;;
+    --batch) BATCH=$2; shift 2;;
+    --out) OUT=$2; shift 2;;
+    -h|--help) sed -n '2,11p' "$0"; exit 0;;
+    *) die "unknown argument $1";;
+  esac
+done
+
+bench_preflight
+DB=bench_ingest
+RAW="$WORK/backend-ingest"
+CERTS="$WORK/ingest-certs"
+LOADGEN="$BIN/loadgen"
+HOST_ID="bench-ingest-host"
+rm -rf "$RAW"; mkdir -p "$RAW/runs" "$OUT"
+: >"$PIDFILE"
+cleanup() { log "cleanup"; bench_planes_down; bench_kill_all; }
+trap cleanup EXIT
+
+bench_build --no-agent
+bench_db_reset "$DB"
+bench_bootstrap "$DB" "$CERTS"
+AGENT_KEY=$(cat "$CERTS/agent_api_key")
+
+bench_env_json "$RAW/env.json"
+cat >"$RAW/config.json" <<JSON
+{"duration_s": $DURATION, "reps": $REPS, "warmup_s": $WARMUP, "batch": $BATCH, "concurrency": [${CONCURRENCY}],
+ "host_id": "$HOST_ID", "event_mix": {"process_exec": 0.30, "file_open": 0.50, "net_connect": 0.20}, "suspicious_share": 0.01,
+ "backend_env": {"CORRELIC_DISABLE_RATE_LIMIT": "1"}}
+JSON
+cat >"$RAW/notes.txt" <<TXT
+Event mix: 30% process_exec, 50% file_open, 20% net_connect, with 1% of file_open/net_connect pointing at ~/.ssh/id_rsa or 203.0.113.5:4444 so detection rules have something to fire on. "AI share 100%" mirrors the Linux agent, which only ships events of AI process trees; the "noise" configs send events without AI context to show what the backend sampler drops.
+The backend processes each batch synchronously (validation, sampling, two inserts per event, detection, correlation) before answering 202, so latency includes PostgreSQL commit time.
+Findings are bounded by the per-rule finding cooldown (10 min default, 15 min for ai.credential_access, 5 min for ai.unexpected_network) per host, so with one host they stay small whatever the event rate.
+The per-key request rate limit (300/min by default, CORRELIC_RATE_LIMIT_PER_MIN) was disabled for the measurement; with it, one agent key is capped at 300 batches/min.
+TXT
+
+db_sizes() { # prints JSON object with table bytes + row counts
+  psql_ -d "$DB" -tA -c "select json_build_object(
+    'telemetry_events_bytes', pg_total_relation_size('telemetry_events'), 'events_bytes', pg_total_relation_size('events'),
+    'findings_bytes', pg_total_relation_size('findings'), 'incidents_bytes', pg_total_relation_size('incidents'),
+    'telemetry_events_rows', (select count(*) from telemetry_events), 'events_rows', (select count(*) from events),
+    'findings_rows', (select count(*) from findings), 'incidents_rows', (select count(*) from incidents))"
+}
+
+run_one() { # <label> <sampling default|off> <ai-share> <concurrency> <rep>
+  local label=$1 sampling=$2 ai=$3 conc=$4 rep=$5
+  local run="$RAW/runs/$label-r$rep"; mkdir -p "$run"
+  log "=== $label (sampling $sampling, ai share $ai, concurrency $conc) rep $rep"
+  local before; before=$(db_sizes)
+  local started_at; started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+  "$LOADGEN" ingest -url "https://127.0.0.1:$TEL_PORT" -api-key "$AGENT_KEY" -ca "$CERTS/ca.crt" -cert "$CERTS/client.crt" -key "$CERTS/client.key" \
+    -host-id "$HOST_ID" -concurrency "$conc" -batch "$BATCH" -duration "${DURATION}s" -warmup "${WARMUP}s" -ai-share "$ai" -suspicious-share 0.01 \
+    -out "$run/ingest.json" >"$run/ingest.log" 2>&1 &
+  local lg=$!
+  sleep "$WARMUP"
+  "$LOADGEN" monitor -duration "${DURATION}s" -proc "telemetry=$TEL_PID" -proc "api=$API_PID" -proc "loadgen=$lg" -comm postgres -out "$run/monitor.json" &
+  local mon=$!
+  wait "$lg" || die "loadgen ingest failed: $(cat "$run/ingest.log")"
+  wait "$mon" || die "monitor failed"
+  sleep 2
+  local after; after=$(db_sizes)
+  printf '{"before": %s, "after": %s}\n' "$before" "$after" >"$run/db.json"
+  cat >"$run/meta.json" <<JSON
+{"label": "$label", "sampling": "$sampling", "ingest_ai_share": $ai, "concurrency": $conc, "batch": $BATCH, "rep": $rep, "duration_s": $DURATION, "started_at": "$started_at"}
+JSON
+  grep -E "accepted_per_s|\"p99\"|request_errors" "$run/ingest.json" | tr -d ' \n' >&2; echo >&2
+}
+
+IFS=, read -ra CONCS <<<"$CONCURRENCY"
+MID=${CONCS[$(( ${#CONCS[@]} / 2 ))]}
+
+bench_planes_up "$DB" "$CERTS" "$RAW/planes-default"
+for rep in $(seq 1 "$REPS"); do
+  for c in "${CONCS[@]}"; do run_one "ai-c$c" default 1.0 "$c" "$rep"; done
+  run_one "noise-c$MID-sampled" default 0.0 "$MID" "$rep"
+done
+bench_planes_down
+
+bench_planes_up "$DB" "$CERTS" "$RAW/planes-off" SAMPLING_ENABLED=false
+for rep in $(seq 1 "$REPS"); do run_one "noise-c$MID-unsampled" off 0.0 "$MID" "$rep"; done
+bench_planes_down
+
+log "aggregating"
+"$LOADGEN" report -kind ingest -in "$RAW" -out-json "$OUT/backend-ingest.json" -out-md "$OUT/backend-ingest.md"
+log "summary written to $OUT/backend-ingest.{json,md}; raw runs in $RAW/runs"
diff --git a/scripts/bench/lib.sh b/scripts/bench/lib.sh
new file mode 100644
index 0000000..6c1cc25
--- /dev/null
+++ b/scripts/bench/lib.sh
@@ -0,0 +1,178 @@
+#!/usr/bin/env bash
+# Shared helpers for scripts/bench/*.sh. Sourced, not executed.
+#
+# Environment knobs (all optional):
+#   BENCH_WORK            scratch directory (default /var/tmp/correlic-bench). Not under /tmp (the
+#                         agent ignores file opens there) and without a path component that matches
+#                         an AI pattern such as "claude" (the agent would attribute every process
+#                         started from it, planes included, to an AI session).
+#   BENCH_PG_HOST/PORT/USER/PASSWORD   PostgreSQL superuser-ish role that may CREATE DATABASE
+#                         (default 127.0.0.1 / 5432 / correlic / empty)
+#   BENCH_API_PORT        API plane port (default 38080)
+#   BENCH_TELEMETRY_PORT  telemetry plane port (default 38081)
+#   BENCH_LIBBPF_INCLUDE  libbpf include dir for `go generate` when the agent's eBPF objects are missing
+#   GO                    go binary (default: go on PATH)
+
+BENCH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$BENCH_DIR/../.." && pwd)"
+WORK="${BENCH_WORK:-/var/tmp/correlic-bench}"
+BIN="$WORK/bin"
+PG_HOST="${BENCH_PG_HOST:-127.0.0.1}"
+PG_PORT="${BENCH_PG_PORT:-5432}"
+PG_USER="${BENCH_PG_USER:-correlic}"
+PG_PASSWORD="${BENCH_PG_PASSWORD:-}"
+API_PORT="${BENCH_API_PORT:-38080}"
+TEL_PORT="${BENCH_TELEMETRY_PORT:-38081}"
+GO="${GO:-go}"
+PIDFILE="$WORK/pids"
+# A throwaway key for the planes' LLM credential encryption (no LLM is used by the benchmarks).
+LLM_KEY="${BENCH_LLM_ENCRYPTION_KEY:-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef}"
+
+log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
+die() { log "ERROR: $*"; exit 1; }
+need() { command -v "$1" >/dev/null 2>&1 || die "missing tool: $1"; }
+
+psql_() {
+  PGPASSWORD="$PG_PASSWORD" psql -v ON_ERROR_STOP=1 -X -q -h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" "$@"
+}
+pg_url() { printf 'postgres://%s%s@%s:%s/%s?sslmode=disable' "$PG_USER" "${PG_PASSWORD:+:$PG_PASSWORD}" "$PG_HOST" "$PG_PORT" "$1"; }
+
+# bench_preflight: tools, root, PostgreSQL reachable.
+bench_preflight() {
+  need "$GO"; need psql; need curl; need pg_isready; need setsid
+  [ "$(id -u)" = 0 ] || die "run as root: the agent needs CAP_BPF/CAP_PERFMON and the benchmark toggles bpf_stats_enabled"
+  PGPASSWORD="$PG_PASSWORD" pg_isready -h "$PG_HOST" -p "$PG_PORT" -q || die "PostgreSQL not reachable at $PG_HOST:$PG_PORT (set BENCH_PG_HOST/PORT/USER)"
+  case "$WORK" in /tmp|/tmp/*) die "BENCH_WORK=$WORK is under /tmp: the agent's path filter ignores file opens there";; esac
+  local comp
+  for comp in $(printf '%s' "$WORK" | tr '/' ' '); do
+    case "$comp" in
+      claude*|cursor*|aider*|codex*|copilot*|windsurf*|gemini*|goose*|cline*|opencode*)
+        die "BENCH_WORK=$WORK has a path component '$comp' that matches an AI pattern: the agent would treat every benchmark process as that AI tool. Pick another directory.";;
+    esac
+  done
+  mkdir -p "$WORK" "$BIN"
+}
+
+# bench_check_ancestry: the agent attributes every descendant of a process that
+# matches an AI pattern to that AI session. If this script is started from an
+# AI coding tool's shell (Claude Code, Cursor, ...) the whole benchmark,
+# including the "noise" generator and the planes, would count as AI activity.
+bench_check_ancestry() {
+  local p=$$ comm
+  while [ -n "$p" ] && [ "$p" != 1 ] && [ -r "/proc/$p/comm" ]; do
+    comm=$(cat "/proc/$p/comm" 2>/dev/null || true)
+    case "$comm" in
+      claude*|cursor*|aider*|codex*|copilot*|windsurf*|gemini*|goose*|cline*|opencode*)
+        if [ "${BENCH_IGNORE_ANCESTRY:-0}" != 1 ]; then
+          die "ancestor pid $p is named '$comm': the agent would attribute this whole benchmark to that AI session.
+Re-run with --detach (the script re-launches itself under setsid -f, reparented to pid 1), or set BENCH_IGNORE_ANCESTRY=1 to proceed anyway."
+        fi
+        ;;
+    esac
+    p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || true)
+  done
+}
+
+# bench_build: planes + admin CLI, the agent (generating eBPF objects if needed) and the load generator.
+bench_build() {
+  log "building planes, admin CLI, agent and loadgen into $BIN"
+  (cd "$REPO_ROOT/backend" && "$GO" build -o "$BIN/correlic-api" ./cmd/api && "$GO" build -o "$BIN/correlic-telemetry" ./cmd/telemetry && "$GO" build -o "$BIN/correlic-admin" ./cmd/admin) || die "backend build failed"
+  if [ "${1:-}" != "--no-agent" ]; then
+    if ! ls "$REPO_ROOT"/agent/internal/ebpf/*_x86_bpfel.o >/dev/null 2>&1 && ! ls "$REPO_ROOT"/agent/internal/ebpf/*_arm64_bpfel.o >/dev/null 2>&1; then
+      log "generating the agent's eBPF objects (go generate)"
+      (cd "$REPO_ROOT/agent" && CPATH="${BENCH_LIBBPF_INCLUDE:-${CPATH:-}}" "$GO" generate ./internal/ebpf/...) || die "go generate failed: set BENCH_LIBBPF_INCLUDE to the libbpf include dir (see agent/internal/ebpf/BUILD.md)"
+    fi
+    (cd "$REPO_ROOT/agent" && GOOS=linux "$GO" build -o "$BIN/correlic-agent" ./cmd/agent) || die "agent build failed"
+  fi
+  (cd "$BENCH_DIR/loadgen" && "$GO" build -o "$BIN/loadgen" .) || die "loadgen build failed"
+}
+
+bench_db_reset() {
+  log "resetting database $1"
+  psql_ -d postgres -c "DROP DATABASE IF EXISTS $1" -c "CREATE DATABASE $1"
+}
+
+# bench_bootstrap <db> <certs-dir>: migrate, create the org + keys + mTLS
+# certificates and rewrite the generated agent.yaml to the benchmark ports.
+# Keys land in <certs-dir>/api_key and <certs-dir>/agent_api_key (mode 600).
+bench_bootstrap() {
+  local db=$1 certs=$2
+  rm -rf "$certs"; mkdir -p "$certs"
+  DATABASE_URL="$(pg_url "$db")" "$BIN/correlic-admin" migrate up >"$certs/migrate.log" 2>&1 || die "migrate failed: $(tail -3 "$certs/migrate.log")"
+  DATABASE_URL="$(pg_url "$db")" "$BIN/correlic-admin" bootstrap --name Bench --certs-dir "$certs" >"$certs/bootstrap.out" 2>&1 || die "bootstrap failed: $(tail -3 "$certs/bootstrap.out")"
+  sed -nE 's/^[[:space:]]*api_key=//p' "$certs/bootstrap.out" | head -1 | tr -d '[:space:]' >"$certs/api_key"
+  sed -nE 's/^[[:space:]]*agent_api_key=//p' "$certs/bootstrap.out" | head -1 | tr -d '[:space:]' >"$certs/agent_api_key"
+  chmod 600 "$certs/api_key" "$certs/agent_api_key"
+  [ -s "$certs/agent_api_key" ] || die "bootstrap printed no agent_api_key"
+  sed -i -E "s#^backend_url:.*#backend_url: \"https://127.0.0.1:$API_PORT\"#; s#^telemetry_url:.*#telemetry_url: \"https://127.0.0.1:$TEL_PORT\"#" "$certs/agent.yaml"
+  log "bootstrap done (certs + agent.yaml in $certs)"
+}
+
+bench_curl() { # <certs-dir> <curl args...>
+  local certs=$1; shift
+  curl -s --cacert "$certs/ca.crt" --cert "$certs/client.crt" --key "$certs/client.key" "$@"
+}
+
+# bench_planes_up <db> <certs-dir> <logdir> [VAR=value ...]: start both planes with
+# the extra environment and wait for /health on both. Exports API_PID/TEL_PID.
+bench_planes_up() {
+  local db=$1 certs=$2 logdir=$3; shift 3
+  mkdir -p "$logdir"
+  (
+    export DATABASE_URL="$(pg_url "$db")" TLS_CERT_FILE="$certs/server.crt" TLS_KEY_FILE="$certs/server.key" MTLS_CA_FILE="$certs/ca.crt" \
+      LLM_ENCRYPTION_KEY="$LLM_KEY" LISTEN_ADDR=":$API_PORT" TELEMETRY_LISTEN_ADDR=":$TEL_PORT" CORRELIC_DISABLE_RATE_LIMIT=1
+    for kv in "$@"; do export "$kv"; done
+    "$BIN/correlic-api" >"$logdir/api.log" 2>&1 & echo $! >"$logdir/api.pid"
+    "$BIN/correlic-telemetry" >"$logdir/telemetry.log" 2>&1 & echo $! >"$logdir/telemetry.pid"
+  )
+  API_PID=$(cat "$logdir/api.pid"); TEL_PID=$(cat "$logdir/telemetry.pid")
+  echo "$API_PID $TEL_PID" >>"$PIDFILE"
+  local i
+  for i in $(seq 1 60); do
+    if bench_curl "$certs" -o /dev/null "https://127.0.0.1:$API_PORT/health" && bench_curl "$certs" -o /dev/null "https://127.0.0.1:$TEL_PORT/health"; then
+      log "planes up (api pid $API_PID on :$API_PORT, telemetry pid $TEL_PID on :$TEL_PORT) after ${i}s"
+      return 0
+    fi
+    kill -0 "$API_PID" 2>/dev/null || die "api plane exited: $(tail -3 "$logdir/api.log")"
+    kill -0 "$TEL_PID" 2>/dev/null || die "telemetry plane exited: $(tail -3 "$logdir/telemetry.log")"
+    sleep 1
+  done
+  die "planes did not become healthy"
+}
+
+bench_planes_down() {
+  [ -n "${API_PID:-}" ] && kill "$API_PID" 2>/dev/null
+  [ -n "${TEL_PID:-}" ] && kill "$TEL_PID" 2>/dev/null
+  wait "${API_PID:-}" "${TEL_PID:-}" 2>/dev/null || true
+  API_PID=""; TEL_PID=""
+}
+
+# bench_kill_all: stop everything recorded in $PIDFILE (used by the EXIT trap).
+bench_kill_all() {
+  local p
+  if [ -f "$PIDFILE" ]; then
+    for p in $(cat "$PIDFILE"); do kill "$p" 2>/dev/null || true; done
+    sleep 1
+    for p in $(cat "$PIDFILE"); do kill -9 "$p" 2>/dev/null || true; done
+    rm -f "$PIDFILE"
+  fi
+}
+
+# bench_env_json <out> : machine facts + git commit for the summary.
+bench_env_json() {
+  local commit dirty
+  commit=$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
+  dirty=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | grep -vc '^?? scripts/bench/results' || true)
+  [ "$dirty" != 0 ] && commit="$commit-dirty"
+  "$BIN/loadgen" sysinfo -set "commit=$commit" -set "date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -set "repo=$(basename "$REPO_ROOT")" -out "$1"
+}
+
+# wait_pid_timeout <pid> <seconds>
+wait_pid_timeout() {
+  local i
+  for i in $(seq 1 "$2"); do kill -0 "$1" 2>/dev/null || return 0; sleep 1; done
+  return 1
+}
+
+# pid_cpu_ms <pid> : cumulative CPU ms of a process (utime+stime), for sanity logging
+pid_cpu_ms() { awk '{print int(($14+$15)*10)}' "/proc/$1/stat" 2>/dev/null || echo 0; }
diff --git a/scripts/bench/loadgen/agentlog.go b/scripts/bench/loadgen/agentlog.go
new file mode 100644
index 0000000..4ebcfc6
--- /dev/null
+++ b/scripts/bench/loadgen/agentlog.go
@@ -0,0 +1,139 @@
+package main
+
+import (
+	"bufio"
+	"flag"
+	"io"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// AgentLogSummary is what `loadgen agentlog` extracts from the agent's slog
+// text output: the dispatcher's "agent drop stats" lines (logged every 30 s
+// when anything was dropped: rate_limited / buffer_full per event type,
+// deduplicated execs, exec cleanup reasons), the throttled per-reason
+// "agent drop" lines, AI session creations and WARN/ERROR counts. The kernel
+// side has no counter for failed bpf_ringbuf_reserve calls, so ring buffer
+// overflow is not observable here (see BENCHMARKS.md).
+type AgentLogSummary struct {
+	Lines           int              `json:"lines"`
+	DropStatsLines  int              `json:"drop_stats_lines"`
+	RateLimited     map[string]int64 `json:"rate_limited"`
+	BufferFull      map[string]int64 `json:"buffer_full"`
+	Deduplicated    int64            `json:"deduplicated"`
+	ExecCleanup     map[string]int64 `json:"exec_cleanup"`
+	DropReasons     map[string]int64 `json:"drop_reason_lines"` // throttled "agent drop" lines by reason
+	AISessions      int              `json:"ai_sessions_created"`
+	Warn            int              `json:"warn"`
+	Error           int              `json:"error"`
+	WarnSamples     []string         `json:"warn_samples,omitempty"`
+	RingbufMentions int              `json:"ringbuf_mentions"`
+}
+
+var (
+	mapFieldRe   = regexp.MustCompile(`(\w+)=("?)map\[([^\]]*)\]`)
+	dedupRe      = regexp.MustCompile(`\bdeduplicated=(\d+)`)
+	reasonRe     = regexp.MustCompile(`\breason=(\S+)`)
+	msgRe        = regexp.MustCompile(`msg="([^"]*)"|msg=(\S+)`)
+	levelWarnRe  = regexp.MustCompile(`\blevel=WARN\b`)
+	levelErrorRe = regexp.MustCompile(`\blevel=ERROR\b`)
+)
+
+func parseMapField(line, field string, into map[string]int64) bool {
+	for _, m := range mapFieldRe.FindAllStringSubmatch(line, -1) {
+		if m[1] != field {
+			continue
+		}
+		for _, kv := range strings.Fields(m[3]) {
+			k, v, ok := strings.Cut(kv, ":")
+			if !ok {
+				continue
+			}
+			n, err := strconv.ParseInt(v, 10, 64)
+			if err != nil {
+				continue
+			}
+			into[k] += n
+		}
+		return true
+	}
+	return false
+}
+
+func summariseAgentLog(r io.Reader) (AgentLogSummary, error) {
+	s := AgentLogSummary{RateLimited: map[string]int64{}, BufferFull: map[string]int64{}, ExecCleanup: map[string]int64{}, DropReasons: map[string]int64{}}
+	seenWarn := map[string]bool{}
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		s.Lines++
+		if strings.Contains(line, `msg="agent drop stats"`) {
+			s.DropStatsLines++
+			parseMapField(line, "rate_limited", s.RateLimited)
+			parseMapField(line, "buffer_full", s.BufferFull)
+			parseMapField(line, "exec_cleanup", s.ExecCleanup)
+			if m := dedupRe.FindStringSubmatch(line); m != nil {
+				n, _ := strconv.ParseInt(m[1], 10, 64)
+				s.Deduplicated += n
+			}
+			continue
+		}
+		if strings.Contains(line, `msg="agent drop"`) {
+			if m := reasonRe.FindStringSubmatch(line); m != nil {
+				s.DropReasons[m[1]]++
+			}
+			continue
+		}
+		if strings.Contains(line, `msg="AI session created"`) {
+			s.AISessions++
+		}
+		if low := strings.ToLower(line); strings.Contains(low, "ringbuf") || strings.Contains(low, "ring buffer") {
+			s.RingbufMentions++
+		}
+		if levelWarnRe.MatchString(line) || levelErrorRe.MatchString(line) {
+			if levelErrorRe.MatchString(line) {
+				s.Error++
+			} else {
+				s.Warn++
+			}
+			msg := ""
+			if m := msgRe.FindStringSubmatch(line); m != nil {
+				msg = m[1] + m[2]
+			}
+			if msg != "" && !seenWarn[msg] && len(s.WarnSamples) < 8 {
+				seenWarn[msg] = true
+				s.WarnSamples = append(s.WarnSamples, msg)
+			}
+		}
+	}
+	return s, sc.Err()
+}
+
+// runAgentLog summarises an agent log, optionally only the bytes written after -offset.
+func runAgentLog(args []string) error {
+	fs := flag.NewFlagSet("agentlog", flag.ContinueOnError)
+	file := fs.String("file", "", "agent log file")
+	offset := fs.Int64("offset", 0, "byte offset to start from (size of the file when the run began)")
+	out := fs.String("out", "", "result JSON path (default stdout)")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	f, err := os.Open(*file)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	if *offset > 0 {
+		if _, err := f.Seek(*offset, io.SeekStart); err != nil {
+			return err
+		}
+	}
+	s, err := summariseAgentLog(f)
+	if err != nil {
+		return err
+	}
+	return writeJSONFile(*out, s)
+}
