# Correlic backend (local dev)
#
# Copy this file to `.env`:
#
#   cp env.example .env
#
# `.env` is ignored by git (see `.gitignore`).

# --- Postgres ---
# Optional. Defaults to postgres://correlic:correlic@localhost:5432/correlic
DATABASE_URL=postgres://correlic:correlic@localhost:5432/correlic

# --- TLS / mTLS (required for cmd/api and cmd/telemetry) ---
TLS_CERT_FILE=.certs/server.crt
TLS_KEY_FILE=.certs/server.key
MTLS_CA_FILE=.certs/ca.crt

# --- LLM provider key encryption (required for cmd/api) ---
# Encrypts stored BYOK provider keys. Generate with: openssl rand -hex 32
LLM_ENCRYPTION_KEY=

# --- Optional remote key server ---
# Leave empty for a self-hosted install. Only keys in the local database are accepted.
CORRELIC_API_URL=

# --- Auth toggles ---
# Optional. When false, API keys are rejected (mTLS-only). Default: true.
ALLOW_API_KEY_AUTH=true

# --- Debug endpoints (mTLS + auth protected) ---
# Optional. Default: false.
ENABLE_DEBUG_ENDPOINTS=false

# --- Retention (days; cleanup runs hourly) ---
RETENTION_EVENTS_DAYS=30
RETENTION_TELEMETRY_DAYS=30
RETENTION_FINDINGS_DAYS=90
RETENTION_INCIDENTS_DAYS=365
RETENTION_CLEANUP_INTERVAL=1h

# --- Email (password reset / verification links); optional ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3001

# --- Behind the ui-proxy only: trust X-Forwarded-For for rate limiting ---
TRUST_PROXY_HEADERS=false
